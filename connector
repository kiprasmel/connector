#!/bin/bash
# connector - headscale/tailscale mesh management tool
set -euo pipefail

VERSION="3.0.0"

# --- Constants ---------------------------------------------------------------
HEADSCALE_USER="mesh"
HEADSCALE_CONFIG="/etc/headscale/config.yaml"
HEADSCALE_ACL="/etc/headscale/acl.hujson"         # what headscale reads: composed (write_acl)
HEADSCALE_ACL_SITE="/etc/headscale/acl.site.json"  # the site's own rules: never overwritten
HEADSCALE_OPS_USER="ops"                           # operators' machines: untagged, this user's
HEADSCALE_BACKUP_RECIPIENTS="/etc/headscale/backup.recipients"  # public keys a backup is encrypted to
HEADSCALE_BACKUP_DIR="/var/backups/headscale"     # the CNC's daily backups (backup-schedule)
HEADSCALE_BACKUP_KEEP=14                          # how many of them stay
BACKUP_UNIT_DIR="/etc/systemd/system"
HEADSCALE_LIB="/var/lib/headscale"
HEADSCALE_BIN="/usr/local/bin/headscale"
# headscale, pinned: a release is this version and the sha256 of each artifact
# connector installs, bumped together (from the release's checksums.txt, and
# the artifacts hashed again). A newer headscale already on the CNC is never
# downgraded: its database has moved on.
HEADSCALE_VERSION="0.29.4"
HEADSCALE_SHA256_AMD64_DEB="1f65364716ae1fcc3845b1a65a47583469022e9c6f194dfdfeb25403f89f0841"
HEADSCALE_SHA256_ARM64_DEB="021a4aeb2106d09c0e6fb5f936acffcbcdea213ef8882b19ea91b03783e1f816"
HEADSCALE_SHA256_AMD64_BIN="212ed0a884c0d3541e094c4bebbe94397df6f4e01bd3d7f059c520cb55e0d757"
HEADSCALE_SHA256_ARM64_BIN="cbad8f02524cc6a94955a107a72e1d4cc652ae3f22e740d5c60884e7f384d60e"
# Where an older connector kept a bare-IP CNC's self-signed certificate: read
# to say which root its nodes must stop trusting (invite --migrate).
HEADSCALE_CERT_DIR="${HEADSCALE_LIB}/certs"
HEADSCALE_CERT="${HEADSCALE_CERT_DIR}/cnc.crt"
# How headscale proves the CNC's name to Let's Encrypt: tls-alpn-01, answered
# on the TLS listener at :443, or http-01, answered on :80.
HS_ACME_DEFAULT="tls-alpn-01"
CONNECTOR_BIN="/usr/local/bin/connector"
CON_BIN="/usr/local/bin/con"        # short 'con' shortcut, symlinked to connector
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/connector"
CNC_LINK_FILE="${STATE_DIR}/cnc"
ROLE_FILE="${STATE_DIR}/role"
CNC_CA_FILE="${STATE_DIR}/cnc-ca.crt"        # an older connector's trusted CNC cert
ALIASES_FILE="${STATE_DIR}/aliases.conf"
TMUX_SOCKET="connector"                       # dedicated tmux server socket (-L)
TMUX_CONF="${STATE_DIR}/tmux.conf"            # connector-managed tmux config
TMUX_USER_CONF="${STATE_DIR}/tmux.user.conf"  # your pushed ~/.tmux.conf
TMUX_RESURRECT_DIR="${STATE_DIR}/resurrect"   # tmux-resurrect save dir (isolated)
TMUX_PUSH_CACHE="${STATE_DIR}/tmux-push.cache"  # per-remote sha of last pushed tmux.user.conf
SSH_CONFIG_FILE="${HOME}/.ssh/config"
KEY_EXPIRY="${CONNECTOR_KEY_EXPIRY:-1h}"
WSL_MTU="1280"
# tailscale's apt repository, trusted by the one key whose fingerprint is
# pinned here ("Tailscale Inc. (Package repository signing key)", the same for
# every release pkgs.tailscale.com serves), named alone by its source.
TS_APT_KEY_FPR="2596A99EAAB33821893C0A79458CA832957F5868"
TS_APT_KEYRING="/usr/share/keyrings/tailscale-archive-keyring.gpg"
TS_APT_LIST="/etc/apt/sources.list.d/tailscale.list"
OS_RELEASE="/etc/os-release"
TS_MAC_APP_CLI="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

RESERVED_COMMANDS=(
    cnc-init cnc-update propagate-update link invite manager-key commander-key register migrate-cnc prod-key backup restore backup-stream restore-stream backup-schedule backup-schedule-local backup-local approve list ls revoke
    status whoami hop ssh tmux cnc alias cleanup cleanup-cnc help --help -h
)

# --- Logging -----------------------------------------------------------------
# warn/error lines are also buffered so they can be replayed after a tmux session
# hands the TTY back (tmux's alternate screen otherwise scrolls them out of view).
LOG_NOTES=()
log_info()    { echo "[INFO] $*"; }
log_success() { echo "[OK] $*"; }
log_warn()    { echo "[WARN] $*"; LOG_NOTES+=("[WARN] $*"); }
log_error()   { echo "[ERROR] $*" >&2; LOG_NOTES+=("[ERROR] $*"); }
die()         { log_error "$*"; exit 1; }

# Replay buffered warnings/errors. Call after a full-screen child (tmux) returns,
# so problems printed before it took the screen are still surfaced to the user.
flush_notes() {
    [ "${#LOG_NOTES[@]}" -gt 0 ] || return 0
    printf '\n[i] %d warning(s)/error(s) during this session:\n' "${#LOG_NOTES[@]}" >&2
    local n; for n in "${LOG_NOTES[@]}"; do printf '    %s\n' "$n" >&2; done
    LOG_NOTES=()
}

# --- Small helpers -----------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

confirm() {
    # confirm "question" [y]  -> returns 0 on yes; ASSUME_YES=1 auto-confirms
    local prompt="$1" default="${2:-n}" reply
    [ "${ASSUME_YES:-0}" = "1" ] && return 0
    if [ "$default" = "y" ]; then
        read -r -p "$prompt [Y/n]: " reply || true
        reply="${reply:-y}"
    else
        read -r -p "$prompt [y/N]: " reply || true
        reply="${reply:-n}"
    fi
    [[ "$reply" =~ ^[Yy]$ ]]
}

require_root() {
    [ "$(id -u)" -eq 0 ] || die "This command must be run as root (try: sudo connector $*)"
}

# Run a command as root locally (no-op prefix when already root).
as_root() {
    if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

# --- Dependencies ------------------------------------------------------------
# Detect the system package manager (prints a token; empty if none recognised).
pkg_mgr() {
    if   have apt-get; then echo apt
    elif have pacman;  then echo pacman
    elif have dnf;     then echo dnf
    elif have yum;     then echo yum
    elif have zypper;  then echo zypper
    elif have apk;     then echo apk
    elif have brew;    then echo brew
    fi
}

# Package that provides a command for a manager (defaults to the command name).
pkg_for() {
    case "$1:$2" in
        hostname:pacman) echo inetutils ;;
        *)               echo "$1" ;;
    esac
}

# Install packages with the detected manager (refreshing the DB first).
pkg_install() {
    case "$(pkg_mgr)" in
        apt)    as_root apt-get update -qq && as_root apt-get install -y "$@" ;;
        pacman) as_root pacman -Sy --needed --noconfirm "$@" ;;
        dnf)    as_root dnf install -y "$@" ;;
        yum)    as_root yum install -y "$@" ;;
        zypper) as_root zypper --non-interactive install "$@" ;;
        apk)    as_root apk add "$@" ;;
        brew)   brew install "$@" ;;
        *)      return 1 ;;
    esac
}

# Ensure required commands exist; offer to install any that are missing.
# Usage: ensure_deps curl openssl
ensure_deps() {
    local cmd mgr
    local -a missing=() pkgs=()
    for cmd in "$@"; do have "$cmd" || missing+=("$cmd"); done
    [ "${#missing[@]}" -eq 0 ] && return 0

    log_warn "Missing required tool(s): ${missing[*]}"
    mgr="$(pkg_mgr)"
    [ -n "$mgr" ] || die "Please install them with your package manager, then re-run."
    for cmd in "${missing[@]}"; do pkgs+=("$(pkg_for "$cmd" "$mgr")"); done
    confirm "Install ${pkgs[*]} via ${mgr}?" y || die "Cannot continue without: ${missing[*]}"
    log_info "Installing: ${pkgs[*]} ..."
    pkg_install "${pkgs[@]}" || die "Failed to install: ${pkgs[*]}"

    local -a still=()
    for cmd in "${missing[@]}"; do have "$cmd" || still+=("$cmd"); done
    [ "${#still[@]}" -eq 0 ] || die "Still missing after install: ${still[*]}"
}

# Best-effort short hostname that does not require the `hostname` binary
# (Arch base, minimal containers, etc. may not ship it). Empty if unknown;
# tailscale then derives the node name itself.
node_name() {
    local n=""
    if have hostname; then n="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"; fi
    if [ -z "$n" ]; then n="${HOSTNAME:-}"; fi
    if [ -z "$n" ] && [ -r /etc/hostname ]; then n="$(cat /etc/hostname 2>/dev/null || true)"; fi
    if [ -z "$n" ]; then n="$(uname -n 2>/dev/null || true)"; fi
    printf '%s\n' "${n%%.*}"
}

# Portable SHA-256 of a file (prints the hex digest; empty if unavailable).
file_sha256() {
    if   have sha256sum; then sha256sum "$1" 2>/dev/null | awk '{print $1}'
    elif have shasum;    then shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
    fi
}

# Resolve the absolute path of this script, following symlinks.
self_path() {
    local s="${BASH_SOURCE[0]}" d
    while [ -h "$s" ]; do
        d=$(cd -P "$(dirname "$s")" >/dev/null 2>&1 && pwd)
        s=$(readlink "$s")
        case "$s" in /*) ;; *) s="$d/$s" ;; esac
    done
    d=$(cd -P "$(dirname "$s")" >/dev/null 2>&1 && pwd)
    printf '%s/%s\n' "$d" "$(basename "$s")"
}

# Extract a top-level JSON string field ("field":"value") from stdin.
json_str() {
    sed -n 's/.*"'"$1"'":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
}

os_kind() {
    case "$(uname -s)" in
        Darwin) echo "macos" ;;
        Linux)  echo "linux" ;;
        *)      echo "other" ;;
    esac
}

# True if $1 looks like a bare IP (v4 or v6), not a DNS hostname.
is_ip() {
    local h="$1"
    case "$h" in *:*) return 0 ;; esac          # IPv6 contains colons
    case "$h" in *[!0-9.]*) return 1 ;; esac     # v4 has only digits + dots
    [ "$(printf '%s' "$h" | tr -cd '.' | wc -c | tr -d ' ')" = "3" ]
}

# Parse host / port out of a URL (handles scheme, [v6]:port, host:port, path).
url_host() {
    local u="${1#*://}"; u="${u%%/*}"
    case "$u" in
        \[*\]*) printf '%s' "${u%%\]*}]" | tr -d '[]' ;;
        *:*)    printf '%s' "${u%%:*}" ;;
        *)      printf '%s' "$u" ;;
    esac
}
url_port() {
    local u="${1#*://}"; u="${u%%/*}"
    case "$u" in
        \[*\]:*) printf '%s' "${u##*]:}" ;;
        \[*\])   printf '' ;;
        *:*)     printf '%s' "${u##*:}" ;;
        *)       printf '' ;;
    esac
}

# SHA-256 fingerprint (lowercase hex, no colons) of a PEM cert on stdin;
# nothing, and rc 0, when stdin holds none.
fp_of_pem() {
    { openssl x509 -noout -fingerprint -sha256 2>/dev/null || true; } \
        | sed 's/.*=//; s/://g' | tr 'A-F' 'a-f' | tr -d '[:space:]'
}

# Fetch the leaf cert a TLS server presents: fetch_live_cert <host> <port>
fetch_live_cert() {
    echo | openssl s_client -connect "${1}:${2}" -servername "$1" 2>/dev/null \
        | openssl x509 2>/dev/null
}

# --- Role detection ----------------------------------------------------------
is_cnc()        { have headscale && [ -f "$HEADSCALE_CONFIG" ]; }
is_manager() { [ -f "$CNC_LINK_FILE" ]; }
is_admin()      { is_cnc || is_manager; }

# Does CSV role-list $1 contain role $2?  e.g. role_has "provider,consumer" provider
role_has() { case ",${1}," in *",${2},"*) return 0 ;; *) return 1 ;; esac; }

node_role() {
    local r=""
    [ -f "$ROLE_FILE" ] && r="$(cat "$ROLE_FILE" 2>/dev/null || true)"
    [ "$r" = "both" ] && r="provider,consumer"   # migrate legacy 'both'
    printf '%s' "$r"
}
is_provider() { role_has "$(node_role)" provider; }
is_consumer() { role_has "$(node_role)" consumer; }
is_ops()      { role_has "$(node_role)" ops; }
is_node()     { have tailscale && tailscale status >/dev/null 2>&1; }

# Canonicalize a comma/space separated node-role spec into an ordered, de-duped
# CSV of tailnet roles (provider[,consumer]). 'both' stays as a legacy alias.
# Dies on any unknown role. Empty input yields empty output (no error).
parse_node_roles() {
    local tok p=0 c=0 o=0 out=""
    for tok in $(printf '%s' "${1:-}" | tr ',' ' '); do
        case "$tok" in
            provider) p=1 ;;
            consumer) c=1 ;;
            both)     p=1; c=1 ;;
            ops)      o=1 ;;
            prod|tag:*) die "A prod machine is not tagged through connector's roles: its key comes from 'connector prod-key' alone." ;;
            *) die "Invalid role: '$tok' (expected provider and/or consumer, or ops)" ;;
        esac
    done
    if [ "$o" = 1 ]; then
        # an operator's machine is untagged (headscale user ops); tags would make it someone else
        [ "$p$c" = 00 ] || die "ops is a machine of its own (an operator's, untagged): not with provider or consumer."
        printf 'ops'
        return 0
    fi
    [ "$p" = 1 ] && out="provider"
    [ "$c" = 1 ] && out="${out:+$out,}consumer"
    printf '%s' "$out"
}

# Map a canonical node-role CSV to a tailscale tag CSV (tag:provider[,tag:consumer]).
tags_for_roles() {
    local tags=()
    role_has "$1" provider && tags+=("tag:provider")
    role_has "$1" consumer && tags+=("tag:consumer")
    # ops has none, and an empty array is unbound under set -u in bash < 4.4
    # (macOS's /bin/bash is 3.2)
    local IFS=,; printf '%s' "${tags[*]+"${tags[*]}"}"
}

current_roles() {
    local roles=()
    is_cnc        && roles+=("cnc")
    is_manager && roles+=("manager")
    is_provider   && roles+=("provider")
    is_consumer   && roles+=("consumer")
    is_ops        && roles+=("ops")
    if [ "${#roles[@]}" -eq 0 ]; then
        if is_node; then roles+=("node (untagged)"); else roles+=("unconfigured"); fi
    fi
    echo "${roles[*]}"
}

# --- CNC link state ----------------------------------------------------------
CNC_SSH=""; CNC_URL=""; CNC_PORT=""; CNC_USER=""

# Resolve the login user for an SSH target (honours ~/.ssh/config for aliases).
resolve_ssh_user() {
    local target="$1" user
    case "$target" in
        *@*) printf '%s\n' "${target%@*}"; return 0 ;;
    esac
    user="$(ssh -G "$target" 2>/dev/null | awk '/^user /{print $2; exit}')"
    [ -n "$user" ] && printf '%s\n' "$user"
}

# What a link's <key> may hold: an ssh target (never an option), a URL, a
# port, a user name. Args: key, value
link_value_ok() {
    case "$1" in
        CNC_SSH)  [[ "$2" =~ ^([a-z_][a-z0-9_.-]*@)?[A-Za-z0-9][A-Za-z0-9._%:-]*$ ]] ;;
        CNC_URL)  [[ "$2" =~ ^https?://([A-Za-z0-9.-]+|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?/?$ ]] ;;
        CNC_PORT) [[ -z "$2" || "$2" =~ ^[0-9]{1,5}$ ]] ;;
        CNC_USER) [[ -z "$2" || "$2" =~ ^[a-z_][a-z0-9_.-]*[$]?$ ]] ;;
        *) return 1 ;;
    esac
}

# The manager link -- CNC_SSH, CNC_URL, CNC_PORT, CNC_USER -- read as
# KEY=VALUE text and never sourced: each value bare or in double quotes, and
# what its key may hold (link_value_ok). Any other line -- another key, code,
# a value that could be read as one -- is refused, not run to find out.
load_cnc_link() {
    local line key val n=0
    local re_quoted='^(CNC_SSH|CNC_URL|CNC_PORT|CNC_USER)="([^"]*)"$'
    local re_bare='^(CNC_SSH|CNC_URL|CNC_PORT|CNC_USER)=([^"[:space:]]*)$'
    [ -f "$CNC_LINK_FILE" ] || die "No CNC linked. Run: connector link <user@host> --url https://..."
    CNC_SSH="" CNC_URL="" CNC_PORT="" CNC_USER=""
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line="${line%$'\r'}"
        case "$line" in ''|'#'*) continue ;; esac
        if [[ "$line" =~ $re_quoted ]] || [[ "$line" =~ $re_bare ]]; then
            key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
        else
            die "${CNC_LINK_FILE}:${n} is not a line connector writes; refused (re-link: connector link <host> --url https://<name>)."
        fi
        link_value_ok "$key" "$val" || die "${CNC_LINK_FILE}:${n}: that is no ${key} ('${val:0:40}'); refused."
        printf -v "$key" '%s' "$val"
    done <"$CNC_LINK_FILE"
    [ -n "$CNC_SSH" ] || die "${CNC_LINK_FILE} names no CNC (CNC_SSH); re-link: connector link <host> --url https://<name>."
    # Prefer a stored user; else derive it (handles bare SSH aliases like 'nyc').
    if [ -z "${CNC_USER:-}" ]; then
        CNC_USER="$(resolve_ssh_user "$CNC_SSH" || true)"
        [ -n "$CNC_USER" ] || CNC_USER="$(id -un)"
    fi
}

# Write the manager link, each value checked as load_cnc_link reads it: a
# link connector would refuse is never written. 0600 from the start.
save_cnc_link() {
    local ssh_target="$1" url="$2" port="${3:-}" user tmp
    link_value_ok CNC_SSH "$ssh_target" || die "'${ssh_target}' is not an ssh target connector links to (user@host, or an alias)."
    link_value_ok CNC_URL "$url" || die "'${url}' is not a URL connector links to."
    link_value_ok CNC_PORT "$port" || die "'${port}' is not a port."
    user="$(resolve_ssh_user "$ssh_target" || true)"; [ -n "$user" ] || user="$(id -un)"
    link_value_ok CNC_USER "$user" || user=""
    mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR" 2>/dev/null || true
    tmp="$(mktemp "${CNC_LINK_FILE}.XXXXXX")" || die "Could not write ${CNC_LINK_FILE}."
    { printf 'CNC_SSH="%s"\nCNC_URL="%s"\nCNC_PORT="%s"\nCNC_USER="%s"\n' "$ssh_target" "$url" "$port" "$user" >"$tmp" \
        && chmod 600 "$tmp" && mv -f "$tmp" "$CNC_LINK_FILE"; } || { rm -f "$tmp"; die "Could not write ${CNC_LINK_FILE}."; }
}

_ssh_port_flag() { [ -n "${CNC_PORT:-}" ] && printf -- '-p %s' "$CNC_PORT" || true; }
_scp_port_flag() { [ -n "${CNC_PORT:-}" ] && printf -- '-P %s' "$CNC_PORT" || true; }

# Run an arbitrary command on the CNC over SSH (as the linked admin user).
ssh_cnc() {
    load_cnc_link
    # shellcheck disable=SC2046,SC2086
    ssh -o ConnectTimeout=10 $(_ssh_port_flag) "$CNC_SSH" "$@"
}

# Run a headscale command against the CNC: locally if we are it, else over SSH.
hs() {
    if is_cnc; then
        as_root headscale "$@"
    elif is_manager; then
        load_cnc_link
        if [ "$CNC_USER" = "root" ]; then
            ssh_cnc headscale "$@"
        else
            ssh_cnc sudo headscale "$@"
        fi
    else
        die "Not a CNC and no CNC linked. Run 'connector cnc-init <host> --url ...' or 'connector link <host> --url ...'."
    fi
}

# Print the CNC's server_url (from local config or the saved link).
cnc_server_url() {
    if is_cnc; then
        sed -n 's/^server_url:[[:space:]]*//p' "$HEADSCALE_CONFIG" 2>/dev/null | head -n1
    elif is_manager; then
        load_cnc_link; printf '%s\n' "$CNC_URL"
    fi
}

# Resolve a node name (or numeric id) to a headscale node id.
resolve_node_id() {
    local node="$1" out
    case "$node" in
        ''|*[!0-9]*) ;;                 # not purely numeric -> look up by name
        *) printf '%s\n' "$node"; return 0 ;;
    esac
    out="$(hs nodes list --output json 2>/dev/null)" || return 1
    if have jq; then
        printf '%s' "$out" | jq -r --arg n "$node" \
            'first(.[] | select((.name==$n) or (.given_name==$n)) | .id) // empty' 2>/dev/null | head -n1
        return 0
    fi
    # Fallback for pretty-printed JSON (best-effort; jq strongly preferred).
    printf '%s' "$out" | tr '\n\t' '  ' | sed 's/  */ /g' \
        | grep -o "\"id\": *\"\{0,1\}[0-9]*\"\{0,1\}[^]]*\"given_name\": *\"$node\"" \
        | sed -n 's/.*"id": *"\{0,1\}\([0-9]*\).*/\1/p' | head -n1
}

# --- CNC: install + configure headscale -------------------------------------
detect_arch() {
    case "$(uname -m)" in
        x86_64|amd64)  echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7l|armv6l) echo "arm" ;;
        *) die "Unsupported architecture: $(uname -m)" ;;
    esac
}

# The installed headscale's version (x.y.z), or nothing.
headscale_installed_version() {
    have headscale || return 0
    { headscale version 2>/dev/null || true; } | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^v?[0-9]+[.][0-9]+[.][0-9]+$/) { sub(/^v/, "", $i); print $i; exit } }'
}

# Is version <a> older than <b>?
version_lt() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | awk 'NR == 1')" = "$1" ]
}

# The pinned release's artifact for <arch> as <kind> (deb | bin): its file
# name, then its sha256. Rc 1 when the pin has none.
headscale_artifact() {
    local sha
    case "$1/$2" in
        amd64/deb) sha="$HEADSCALE_SHA256_AMD64_DEB" ;;
        arm64/deb) sha="$HEADSCALE_SHA256_ARM64_DEB" ;;
        amd64/bin) sha="$HEADSCALE_SHA256_AMD64_BIN" ;;
        arm64/bin) sha="$HEADSCALE_SHA256_ARM64_BIN" ;;
        *) return 1 ;;
    esac
    printf 'headscale_%s_linux_%s%s %s\n' "$HEADSCALE_VERSION" "$1" "$([ "$2" = deb ] && echo .deb)" "$sha"
}

# headscale at the pinned release: downloaded, checked against its pinned
# sha256 before anything is installed, and put in over an older one.
install_headscale() {
    local have_ver arch kind name sha tmp
    have_ver="$(headscale_installed_version)"
    if [ "$have_ver" = "$HEADSCALE_VERSION" ]; then
        log_info "headscale ${HEADSCALE_VERSION} (the pinned release) is installed"
        return 0
    fi
    if [ -n "$have_ver" ] && version_lt "$HEADSCALE_VERSION" "$have_ver"; then
        die "headscale ${have_ver} is installed, newer than the pinned ${HEADSCALE_VERSION}: connector never downgrades it (its database has moved on); bump the pin instead."
    fi
    arch="$(detect_arch)"
    if have apt-get; then kind="deb"; else kind="bin"; fi
    read -r name sha < <(headscale_artifact "$arch" "$kind") || true
    [ -n "${sha:-}" ] || die "No pinned headscale ${HEADSCALE_VERSION} for linux/${arch} (${kind})."
    tmp="$(mktemp -d)"
    log_info "Installing headscale ${HEADSCALE_VERSION} (${kind}, ${arch})${have_ver:+ over ${have_ver}}..."
    curl -fsSL -o "$tmp/$name" "https://github.com/juanfont/headscale/releases/download/v${HEADSCALE_VERSION}/${name}" \
        || { rm -rf "$tmp"; die "Could not download ${name}."; }
    [ "$(file_sha256 "$tmp/$name")" = "$sha" ] \
        || { rm -rf "$tmp"; die "${name} is not the pinned release (its sha256 is not ${sha}); nothing installed."; }
    if [ "$kind" = "deb" ]; then
        as_root apt-get update -y
        as_root apt-get install -y "$tmp/$name"
    else
        as_root install -m 0755 "$tmp/$name" "$HEADSCALE_BIN"
        install_headscale_service
    fi
    rm -rf "$tmp"
}

install_headscale_service() {
    log_info "Creating headscale systemd unit..."
    as_root mkdir -p "$HEADSCALE_LIB" /etc/headscale
    as_root tee /etc/systemd/system/headscale.service >/dev/null <<EOF
[Unit]
Description=headscale controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${HEADSCALE_BIN} serve
Restart=always
RestartSec=5
WorkingDirectory=${HEADSCALE_LIB}
RuntimeDirectory=headscale
StateDirectory=headscale

[Install]
WantedBy=multi-user.target
EOF
    as_root systemctl daemon-reload
}

# --- The CNC's name and certificate -------------------------------------------
# The CNC is a DNS name, and headscale gets that name's certificate from Let's
# Encrypt itself (ACME) and renews it in-process: a node verifies the control
# server against the public roots it already has, and connector installs no
# trust root on any machine. (An older connector served a bare IP with a
# self-signed CA:TRUE certificate and trusted it as a root on every node:
# whoever held its key could pass for any site to all of them. migrate-cnc
# takes a node off it.)

# Can <url> be the CNC's? https, a DNS name, a port (1-65535) or none, and
# nothing else. Says why not.
cnc_url_ok() {
    local url="$1" host port re='^https://(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.-]+)(:([0-9]{1,5}))?/?$'
    [[ "$url" =~ $re ]] || { log_error "The CNC's URL is https://<name>[:port], not '$url'."; return 1; }
    host="${BASH_REMATCH[1]}" port="${BASH_REMATCH[3]}"
    host="${host#\[}"; host="${host%\]}"
    if is_ip "$host"; then
        log_error "The CNC is a DNS name, not an address ($host): point an A record at it and use https://<name>."
        log_error "(connector no longer makes every node trust a certificate of its own; 'connector migrate-cnc' moves a node off one.)"
        return 1
    fi
    [[ "$host" =~ ^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] \
        || { log_error "'$host' is not a DNS name."; return 1; }
    [ -z "$port" ] || (( 10#$port >= 1 && 10#$port <= 65535 )) || { log_error "'$port' is not a port."; return 1; }
}

# SHA-1 (uppercase hex, no colons) of a PEM cert on stdin: what macOS's
# security(1) names a certificate by. Nothing, and rc 0, when stdin holds none.
sha1_of_pem() {
    { openssl x509 -noout -fingerprint -sha1 2>/dev/null || true; } | sed 's/.*=//; s/://g' | tr 'a-f' 'A-F' | tr -d '[:space:]'
}

# p11-kit anchor directories used by Fedora/RHEL, Arch, and SUSE respectively.
CA_ANCHOR_DIRS="/etc/pki/ca-trust/source/anchors /etc/ca-certificates/trust-source/anchors /etc/pki/trust/anchors"
MACOS_SYSTEM_KEYCHAIN="/Library/Keychains/System.keychain"

# Stop trusting the certificate whose SHA-256 is <want>, which an older
# connector made this machine trust as a root: that certificate, matched by
# its fingerprint, and nothing else. Rc 0 whether it was there or not.
# Args: sha256 (lowercase hex)
untrust_cert_sha256() {
    local want="$1"
    [[ "$want" =~ ^[0-9a-f]{64}$ ]] || { log_error "'$want' is not a SHA-256 fingerprint."; return 1; }
    case "$(os_kind)" in
        macos) untrust_macos_sha256 "$want" ;;
        linux) untrust_linux_sha256 "$want" ;;
        *)     log_warn "Unknown OS; remove the certificate $want from its trust store by hand." ;;
    esac
}

# macOS: every certificate in the System keychain, each hashed here, and the
# one that matches removed with its trust setting.
untrust_macos_sha256() {
    local want="$1" dir f sha1 found=0
    dir="$(mktemp -d)"
    security find-certificate -a -p "$MACOS_SYSTEM_KEYCHAIN" 2>/dev/null \
        | awk -v d="$dir" '/-----BEGIN CERTIFICATE-----/ { n++; f = d "/" n ".pem" } f { print > f } /-----END CERTIFICATE-----/ { close(f); f = "" }'
    for f in "$dir"/*.pem; do
        [ -f "$f" ] || continue
        [ "$(fp_of_pem <"$f")" = "$want" ] || continue
        sha1="$(sha1_of_pem <"$f")"
        log_info "Removing the old CNC certificate from the System keychain (SHA-1 ${sha1}; needs sudo)..."
        sudo security remove-trusted-cert -d "$f" 2>/dev/null || true
        sudo security delete-certificate -Z "$sha1" "$MACOS_SYSTEM_KEYCHAIN" \
            || { rm -rf "$dir"; log_error "Could not remove it; by hand: sudo security delete-certificate -Z $sha1 $MACOS_SYSTEM_KEYCHAIN"; return 1; }
        found=1
    done
    rm -rf "$dir"
    if [ "$found" = 1 ]; then log_success "The old CNC certificate is no longer trusted."
    else log_info "No certificate ${want:0:16}... in the System keychain; nothing to remove."; fi
}

# Linux: the files an older connector wrote into the CA store, each only if it
# is that certificate, then the store rebuilt; and p11-kit's own copy.
untrust_linux_sha256() {
    local want="$1" f d removed=0
    for f in /usr/local/share/ca-certificates/headscale-cnc.crt $(for d in $CA_ANCHOR_DIRS; do printf '%s/headscale-cnc.crt ' "$d"; done); do
        [ -f "$f" ] || continue
        if [ "$(fp_of_pem <"$f")" != "$want" ]; then
            log_warn "$f is not the certificate ${want:0:16}...; left as it is."
            continue
        fi
        as_root rm -f "$f" || return 1
        removed=1
    done
    if [ "$removed" = 1 ]; then
        if have update-ca-certificates; then as_root update-ca-certificates --fresh >/dev/null 2>&1 || return 1; fi
        if have update-ca-trust; then
            as_root update-ca-trust extract >/dev/null 2>&1 || as_root update-ca-trust >/dev/null 2>&1 || return 1
        fi
    fi
    # `trust anchor --store` kept a copy under a name of its own; it is removed by the certificate itself.
    if have trust && [ -s "$CNC_CA_FILE" ] && [ "$(fp_of_pem <"$CNC_CA_FILE")" = "$want" ]; then
        as_root trust anchor --remove "$CNC_CA_FILE" >/dev/null 2>&1 && removed=1
    fi
    if [ "$removed" = 1 ]; then log_success "The old CNC certificate is no longer trusted."
    else log_info "No certificate ${want:0:16}... in the CA store; nothing to remove."; fi
}

# headscale's config for <url>, a DNS name whose certificate headscale gets by
# ACME <challenge> (tls-alpn-01 | http-01). Stdout. Args: url, base_domain, challenge
render_headscale_config() {
    local url="$1" base_domain="$2" challenge="$3" host port acme
    host="$(url_host "$url")"; port="$(url_port "$url")"; [ -n "$port" ] || port="443"
    case "$challenge" in
        tls-alpn-01) acme="tls_letsencrypt_challenge_type: TLS-ALPN-01" ;;
        http-01)     acme="$(printf 'tls_letsencrypt_challenge_type: HTTP-01\ntls_letsencrypt_listen: ":http"')" ;;
        *) log_error "Unknown ACME challenge '$challenge' (tls-alpn-01 or http-01)."; return 1 ;;
    esac
    cat <<EOF
# Written by connector cnc-init: an edit here is replaced on its next run.
server_url: ${url}
listen_addr: 0.0.0.0:${port}
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false

noise:
  private_key_path: ${HEADSCALE_LIB}/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: "headscale"
    region_name: "Connector Embedded DERP"
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: ${HEADSCALE_LIB}/derp_server_private.key
    automatically_add_embedded_derp_region: true
  urls: []
  paths: []
  auto_update_enabled: false
  update_frequency: 24h

disable_check_updates: true

database:
  type: sqlite
  sqlite:
    path: ${HEADSCALE_LIB}/db.sqlite

tls_letsencrypt_hostname: "${host}"
tls_letsencrypt_cache_dir: ${HEADSCALE_LIB}/cache
${acme}

log:
  level: info
  format: text

policy:
  mode: file
  path: ${HEADSCALE_ACL}

dns:
  magic_dns: true
  base_domain: ${base_domain}
  nameservers:
    global:
      - 1.1.1.1
      - 1.0.0.1
  search_domains: []

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"
EOF
}

write_headscale_config() {
    local cfg
    cfg="$(render_headscale_config "$1" "$2" "$3")" || return 1
    as_root mkdir -p /etc/headscale "$HEADSCALE_LIB"
    printf '%s\n' "$cfg" | as_root tee "$HEADSCALE_CONFIG" >/dev/null
    as_root chmod 644 "$HEADSCALE_CONFIG"
}

# connector's own policy: consumers reach providers, and SSH to them as a
# non-root user. Stdout (strict JSON).
render_acl() {
    cat <<EOF
{
  "tagOwners": {
    "tag:provider": ["${HEADSCALE_USER}@"],
    "tag:consumer": ["${HEADSCALE_USER}@"]
  },
  "acls": [
    { "action": "accept", "src": ["tag:consumer"], "dst": ["tag:provider:*"] }
  ],
  "ssh": [
    {
      "action": "accept",
      "src": ["tag:consumer"],
      "dst": ["tag:provider"],
      "users": ["autogroup:nonroot"]
    }
  ]
}
EOF
}

# The site's own rules, written only where there are none and never
# overwritten: the site edits them (strict JSON). This default is the
# operators' (machines of headscale user ops, group:ops): they reach prod
# machines (tag:prod) on ssh and https and nothing else of them, and what a
# consumer reaches. A prod machine is granted nothing, and no one has
# Tailscale SSH to one: OpenSSH keys stay the way in. Stdout.
render_site_acl() {
    cat <<EOF
{
  "groups": { "group:ops": ["${HEADSCALE_OPS_USER}@"] },
  "tagOwners": { "tag:prod": ["group:ops"] },
  "acls": [
    { "action": "accept", "src": ["group:ops"], "dst": ["tag:prod:22,443"] },
    { "action": "accept", "src": ["group:ops"], "dst": ["tag:provider:*"] }
  ],
  "ssh": [
    { "action": "accept", "src": ["group:ops"], "dst": ["tag:provider"], "users": ["autogroup:nonroot"] }
  ]
}
EOF
}

# connector's rules and the site's, as headscale reads them: groups,
# tagOwners and hosts from both (the site's winning a name both use), acls
# and ssh rules connector's, then the site's. A site fragment holding
# anything else (grants, autoApprovers, ...) is refused, never dropped
# unseen. Args: base file, site file. Stdout.
compose_acl() {
    jq -n --slurpfile b "$1" --slurpfile s "$2" '
        $b[0] as $b | ($s[0] // {}) as $s
        | ($s | if type == "object" then keys - ["groups", "tagOwners", "hosts", "acls", "ssh"] else ["(it is no object)"] end) as $more
        | if $more == [] then . else error("connector composes groups, tagOwners, hosts, acls and ssh from the site, and nothing else: not \($more | join(", "))") end
        | { groups:    (($b.groups // {}) + ($s.groups // {})),
            tagOwners: (($b.tagOwners // {}) + ($s.tagOwners // {})),
            hosts:     (($b.hosts // {}) + ($s.hosts // {})),
            acls:      (($b.acls // []) + ($s.acls // [])),
            ssh:       (($b.ssh // []) + ($s.ssh // [])) }
        | with_entries(select(.value | length > 0))'
}

# Does the policy in <file> grant a prod machine (tag:prod...) nothing, and
# give no one SSH to one? No acl's source, and no ssh rule's source or
# destination, may take one in: a tag:prod... tag, "*", autogroup:tagged or
# autogroup:danger-all, or an address or prefix holding an address of the
# tailnet's (render_headscale_config's prefixes), itself or by a hosts name.
# What it cannot read counts as taking one in. Says which rules when not.
acl_keeps_prod_closed() {
    local bad
    bad="$(jq -c '
        def v4: if test("^[0-9]{1,3}([.][0-9]{1,3}){3}$") then split(".") | map(tonumber) | .[0] * 16777216 + .[1] * 65536 + .[2] * 256 + .[3] else null end;
        def hex: ascii_downcase | explode | reduce .[] as $c (0; . * 16 + (if $c >= 97 then $c - 87 else $c - 48 end));
        # the first 48 bits of an IPv6 address, or null
        def v6_48:
            if test("^[0-9A-Fa-f:]+$") | not then null
            else (if test("::") then (split("::") | map(if . == "" then [] else split(":") end)) as [$h, $t]
                    | $h + [range(8 - ($h | length) - ($t | length)) | "0"] + $t
                  else split(":") end)
                 | if length == 8 and all(.[]; test("^[0-9A-Fa-f]{1,4}$")) then (.[0] | hex) * 4294967296 + (.[1] | hex) * 65536 + (.[2] | hex) else null end
            end;
        # do <a>/<n> and <b>/<m> share an address, in <bits>? Their first min(n, m) bits agree.
        def meet($a; $n; $b; $m; $bits): pow(2; $bits - ([$n, $m] | min)) as $blk | (($a / $blk) | floor) == (($b / $blk) | floor);
        def holds_tailnet:
            split("/") as $p | (($p[1] // null) | if . == null then null else (tonumber? // -1) end) as $len
            | if ($p | length) > 2 then true
              elif ($p[0] | test(":")) then ($p[0] | v6_48) as $a | ($len // 128) as $n
                | if $a == null or $n < 0 or $n > 128 then true
                  else meet($a; [$n, 48] | min; "fd7a:115c:a1e0::" | v6_48; 48; 48) end
              else ($p[0] | v4) as $a | ($len // 32) as $n
                | if $a == null or $n < 0 or $n > 32 then true
                  else meet($a; $n; "100.64.0.0" | v4; 10; 32) end
              end;
        def takes_prod($hosts):
            if type != "string" then true
            elif startswith("tag:") then startswith("tag:prod")
            elif . == "*" or . == "autogroup:tagged" or . == "autogroup:danger-all" then true
            elif startswith("autogroup:") or startswith("group:") or contains("@") then false
            elif $hosts[.] != null then ($hosts[.] | if type == "string" then holds_tailnet else true end)
            else holds_tailnet end;
        (.hosts // {}) as $h
        | ((.acls // [])[] | select(any(.src[]?; takes_prod($h)))),
          ((.ssh // [])[] | select(any(.src[]?, .dst[]?; takes_prod($h))))' "$1")" || return 1
    [ -n "$bad" ] || return 0
    log_error "A prod machine is granted nothing, and no one gets SSH to one; refused:"
    printf '%s\n' "$bad" | sed 's/^/    /' >&2
    return 1
}

# The policy headscale reads: connector's rules and the site's, composed --
# the site's written first where there are none, never overwritten -- and
# refused when it would open a prod machine (acl_keeps_prod_closed).
write_acl() {
    local tmp
    have jq || { log_error "jq composes the policy: apt-get install jq"; return 1; }
    tmp="$(mktemp -d)"
    render_acl >"$tmp/base.json"
    if ! as_root test -e "$HEADSCALE_ACL_SITE"; then
        as_root mkdir -p /etc/headscale
        render_site_acl | as_root tee "$HEADSCALE_ACL_SITE" >/dev/null
        as_root chmod 644 "$HEADSCALE_ACL_SITE"
        log_info "Wrote the site's policy ${HEADSCALE_ACL_SITE}: yours from now on (connector never overwrites it)."
    fi
    as_root cat "$HEADSCALE_ACL_SITE" >"$tmp/site.json"
    if ! compose_acl "$tmp/base.json" "$tmp/site.json" >"$tmp/acl.json" 2>"$tmp/err"; then
        log_error "${HEADSCALE_ACL_SITE} is not composed (strict JSON, and what connector composes): $(cat "$tmp/err")"
        rm -rf "$tmp"; return 1
    fi
    acl_keeps_prod_closed "$tmp/acl.json" || { rm -rf "$tmp"; return 1; }
    as_root install -m 644 "$tmp/acl.json" "$HEADSCALE_ACL"
    rm -rf "$tmp"
}

# headscale's new config and policy, put in place only if headscale takes
# them: the ones before are kept beside them and put back when configtest
# refuses, so a CNC is never restarted onto what its headscale cannot run.
# Args: url, base_domain, challenge
apply_headscale_config() {
    local f err
    for f in "$HEADSCALE_CONFIG" "$HEADSCALE_ACL"; do
        if as_root test -f "$f"; then as_root cp -p "$f" "$f.prev"; else as_root rm -f "$f.prev"; fi
    done
    write_headscale_config "$1" "$2" "$3" && write_acl && err="$(as_root headscale configtest 2>&1)" && return 0
    for f in "$HEADSCALE_CONFIG" "$HEADSCALE_ACL"; do
        if as_root test -f "$f.prev"; then as_root mv -f "$f.prev" "$f"; else as_root rm -f "$f"; fi
    done
    log_error "Not applied; the config and policy before are back in place."
    [ -z "${err:-}" ] || printf '%s\n' "$err" | awk '/[Ee]rror|[Ff]atal|not found/' >&2
    return 1
}

# Open what headscale serves on a host firewall that is already active, never
# enabling one (lockout risk). Args: tcp port...
open_firewall() {
    local -a rules=() ; local p
    for p in "$@"; do rules+=("${p}/tcp"); done
    rules+=(3478/udp 41641/udp)
    if have ufw && as_root ufw status 2>/dev/null | grep -q "Status: active"; then
        for p in "${rules[@]}"; do as_root ufw allow "$p" >/dev/null 2>&1 || true; done
        log_success "ufw rules added (${rules[*]})"
    elif have firewall-cmd && as_root firewall-cmd --state >/dev/null 2>&1; then
        for p in "${rules[@]}"; do as_root firewall-cmd --permanent --add-port="$p" >/dev/null 2>&1 || true; done
        as_root firewall-cmd --reload >/dev/null 2>&1 || true
        log_success "firewalld rules added (${rules[*]})"
    else
        log_info "No active host firewall detected; not enabling one."
        log_info "Ensure these are open (including any cloud firewall): ${rules[*]}"
    fi
}

# What else listens on TCP <port> here, other than headscale: printed, rc 0.
# Rc 1 when nothing does (or ss cannot say).
port_taken_by_other() {
    local line
    have ss || return 1
    line="$(as_root ss -ltnpH "sport = :${1}" 2>/dev/null | awk '!/"headscale"/ && !seen { print; seen = 1 }')"
    [ -n "$line" ] || return 1
    printf '%s\n' "$line"
}

# Does <host> resolve to an address of this machine? Let's Encrypt validates
# whatever it resolves to. Says what it found when not.
name_points_here() {
    local host="$1" addrs mine a
    addrs="$(getent ahosts "$host" 2>/dev/null | awk '{ print $1 }' | sort -u)"
    [ -n "$addrs" ] || { log_warn "${host} does not resolve: Let's Encrypt cannot validate it."; return 1; }
    mine="$(ip -o addr show 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4 }')"
    for a in $addrs; do
        case $'\n'"$mine"$'\n' in *$'\n'"$a"$'\n'*) return 0 ;; esac
    done
    log_warn "${host} resolves to ${addrs//$'\n'/ } -- none of them this machine's; Let's Encrypt validates there."
    return 1
}

ensure_headscale_user() {
    if as_root headscale users list 2>/dev/null | grep -qw "$HEADSCALE_USER"; then
        log_info "headscale user '$HEADSCALE_USER' already exists"
    else
        as_root headscale users create "$HEADSCALE_USER" >/dev/null 2>&1 \
            || log_warn "Could not create headscale user '$HEADSCALE_USER' (may already exist)"
        log_success "headscale user '$HEADSCALE_USER' ready"
    fi
}

# Is <d> a base domain (MagicDNS's suffix): a DNS name of labels.
base_domain_ok() {
    [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$ ]]
}

# The base domain cnc-init renders: <given>, else the one the CNC's config
# has -- a re-run keeps it, every node's MagicDNS name with it -- else
# connector.mesh. Args: given
cnc_base_domain() {
    local d="$1"
    [ -n "$d" ] || d="$(awk '/^[[:space:]]+base_domain:/ { gsub(/["\047]/, "", $2); print $2; exit }' "$HEADSCALE_CONFIG" 2>/dev/null || true)"
    base_domain_ok "$d" || d="connector.mesh"
    printf '%s\n' "$d"
}

cnc_init_local() {
    local url="$1" base_domain="$2" challenge="${3:-$HS_ACME_DEFAULT}"
    require_root cnc-init
    [ -n "$url" ] || die "Usage: connector cnc-init --url https://<name>[:port] [--acme tls-alpn-01|http-01]"
    cnc_url_ok "$url" || die "Not a URL the CNC can be: $url"
    [ -z "$base_domain" ] || base_domain_ok "$base_domain" || die "'$base_domain' is not a base domain (a DNS name)."
    base_domain="$(cnc_base_domain "$base_domain")"

    local host port p taken
    host="$(url_host "$url")"; port="$(url_port "$url")"; [ -n "$port" ] || port="443"
    case "$challenge" in
        tls-alpn-01) [ "$port" = 443 ] || die "tls-alpn-01 is answered on :443: serve on :443, or use --acme http-01 to serve on :${port}." ;;
        http-01) ;;
        *) die "Unknown --acme '$challenge' (tls-alpn-01 or http-01)." ;;
    esac
    # headscale would fail to bind, and the mesh would lose its control plane.
    for p in "$port" $([ "$challenge" = http-01 ] && echo 80); do
        if taken="$(port_taken_by_other "$p")"; then
            die "Something else listens on :${p} here: ${taken} -- free it, or for :443 use --acme http-01 with another port in --url."
        fi
    done
    name_points_here "$host" || confirm "Continue anyway?" || die "Point ${host}'s A record at this machine, then re-run."

    install_self_local        # ensure 'connector' + 'con' are on PATH on the CNC

    log_info "Initialising CNC (headscale) for ${url}: Let's Encrypt, ${challenge}"
    have curl || as_root apt-get install -y curl >/dev/null 2>&1 || true
    have jq || as_root apt-get install -y jq >/dev/null 2>&1 || true
    install_headscale
    apply_headscale_config "$url" "$base_domain" "$challenge" || die "The CNC's config and policy are as they were."
    log_info "Enabling + starting headscale..."
    as_root systemctl enable headscale >/dev/null 2>&1 || true
    as_root systemctl restart headscale
    sleep 2
    ensure_headscale_user
    if [ "$challenge" = http-01 ]; then open_firewall "$port" 80; else open_firewall "$port"; fi
    # a daily backup that is scheduled runs as this connector writes it
    ( backup_schedule_local --refresh ) || log_warn "The daily backup's units are as they were: connector backup-schedule"

    echo
    if as_root systemctl is-active --quiet headscale; then
        log_success "CNC ready at ${url}"
    else
        log_warn "headscale is not active yet - check: journalctl -u headscale -e"
    fi
    echo "Let's Encrypt issues ${host}'s certificate on the first connection (journalctl -u headscale -f)."
    echo "Next: authorize a machine:  connector invite"
}

# --- cnc-init dispatcher + remote orchestration + link ----------------------
cmd_cnc_init() {
    local host="" url="" port="" base_domain="" acme="$HS_ACME_DEFAULT" reinit=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --url)         url="$2"; shift 2 ;;
            --base-domain) base_domain="$2"; shift 2 ;;
            --acme)        acme="$2"; shift 2 ;;
            --reinit)      reinit=1; shift ;;
            -p|--port)     port="$2"; shift 2 ;;
            -*) die "Unknown option: $1" ;;
            *) [ -z "$host" ] && host="$1" || die "Unexpected argument: $1"; shift ;;
        esac
    done
    case "$acme" in tls-alpn-01|http-01) ;; *) die "Unknown --acme '$acme' (tls-alpn-01 or http-01)." ;; esac
    [ -z "$base_domain" ] || base_domain_ok "$base_domain" || die "'$base_domain' is not a base domain (a DNS name)."
    if [ -n "$host" ]; then
        cnc_init_remote "$host" "$url" "$port" "$acme" "$reinit" "$base_domain"
    else
        cnc_init_local "$url" "$base_domain" "$acme"
    fi
}

# Resolve an ssh target/alias to its configured HostName (IP or domain).
ssh_resolved_host() {
    ssh -G "$1" 2>/dev/null | awk '/^hostname /{print $2; exit}'
}

# Bounded TCP connect test (never hangs on a filtered port). port_open <host> <port> [timeout]
port_open() {
    local host="$1" port="$2" to="${3:-5}" pid i
    ( exec 3<>"/dev/tcp/${host}/${port}" ) 2>/dev/null &
    pid=$!
    for (( i=0; i < to*10; i++ )); do
        kill -0 "$pid" 2>/dev/null || break    # connect finished (ok or refused)
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then         # still running -> timed out
        kill -9 "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        return 1
    fi
    wait "$pid"                                  # propagate connect exit status
}

# Verify the CNC TLS port is reachable from here; loop with a re-check option.
check_cnc_reachable() {
    local url="$1" host port ans
    host="$(url_host "$url")"; port="$(url_port "$url")"; [ -n "$port" ] || port="443"
    while true; do
        log_info "Checking ${host}:${port} reachability (5s timeout)..."
        if port_open "$host" "$port" 5; then
            log_success "${host}:${port} is reachable."
            return 0
        fi
        echo
        log_warn "Could NOT reach ${host}:${port} - a firewall is most likely blocking it."
        echo "  Add these INBOUND rules on the CNC's firewall, INCLUDING any CLOUD"
        echo "  firewall (e.g. DigitalOcean -> Networking -> Firewalls):"
        echo "      ${port}/tcp    headscale control plane + DERP"
        echo "      3478/udp       STUN (NAT traversal)"
        echo "      41641/udp      tailscale direct connections"
        echo
        if ! read -r -p "[r] re-check (default)   [c] continue anyway   [a] abort: " ans </dev/tty 2>/dev/null; then
            log_warn "No interactive terminal; continuing without a verified check."
            return 0
        fi
        case "${ans:-r}" in
            c|C) log_warn "Continuing without verified reachability."; return 0 ;;
            a|A) die "Aborted. Open the firewall, then re-run." ;;
            *)   ;;  # anything else (incl. empty / 'r') -> re-check
        esac
    done
}

cnc_init_remote() {
    local host="$1" url="$2" port="$3" acme="${4:-$HS_ACME_DEFAULT}" reinit="${5:-0}" base_domain="${6:-}" sshflag configured=0
    have ssh || die "ssh not found"; have scp || die "scp not found"
    sshflag="$([ -n "$port" ] && echo "-p $port" || true)"

    log_info "Checking SSH access to $host..."
    # shellcheck disable=SC2086
    ssh -o ConnectTimeout=10 $sshflag "$host" true || die "Cannot SSH to $host"

    # Only prefix sudo when the remote login user is not root (avoids noise + works for non-root admins).
    local rsudo="sudo "
    # shellcheck disable=SC2086
    if ssh $sshflag "$host" 'test "$(id -u)" = 0' 2>/dev/null; then rsudo=""; fi

    # shellcheck disable=SC2086
    if ssh $sshflag "$host" 'test -f /etc/headscale/config.yaml && systemctl is-active --quiet headscale' 2>/dev/null; then
        configured=1
    fi

    # The server URL: --url, else the one the CNC already serves -- a DNS name
    # either way (cnc_url_ok); a CNC still on a bare IP needs --url to move.
    local existing=""
    if [ "$configured" = 1 ]; then
        # shellcheck disable=SC2086
        existing="$(ssh $sshflag "$host" "${rsudo}sed -n 's/^server_url:[[:space:]]*//p' /etc/headscale/config.yaml 2>/dev/null | head -n1" | tr -d '\r')"
    fi
    [ -n "$url" ] || url="$existing"
    [ -n "$url" ] || die "Pass the CNC's name: --url https://<name> (an A record pointing at $host)."
    cnc_url_ok "$url" || die "Not a URL the CNC can be: $url"

    if [ "$configured" = 1 ] && [ "$url" = "$existing" ] && [ "$reinit" = 0 ]; then
        log_info "CNC already configured on $host at ${url}; skipping install (--reinit applies this connector to it)."
    else
        if [ "$configured" = 1 ] && [ "$url" != "$existing" ]; then
            log_warn "This moves the CNC from ${existing} to ${url}. Every node then follows with"
            log_warn "'connector migrate-cnc' (a fresh key from 'connector invite --migrate <roles> <node>')."
            confirm "Move the CNC to ${url}?" || die "Declined."
        fi
        log_info "Copying connector to $host and running cnc-init..."
        push_connector "$host" "$rsudo" 0 "$port" || die "Could not install connector on $host."
        # shellcheck disable=SC2086
        # no --base-domain: the CNC keeps the one it has (cnc_base_domain)
        ssh -t $sshflag "$host" "${rsudo}${CONNECTOR_BIN} cnc-init --url '$url' --acme '$acme'${base_domain:+ --base-domain '$base_domain'}" \
            || die "Remote cnc-init failed"
    fi

    save_cnc_link "$host" "$url" "$port"
    log_success "Linked to CNC $host (this machine is now a manager)."

    check_cnc_reachable "$url"

    echo
    echo "Also register THIS local machine (the one you're running connector on)"
    echo "as a tailnet node?"
    echo "  [1] provider (others can reach/SSH it)   [2] consumer (it reaches providers)"
    echo "  enter '1 2' for both, or [s] to skip"
    local choice; read -r -p "Choose: " choice || choice="s"
    local reg_roles=""
    case "$(echo "$choice" | tr -d ' ')" in
        1)        reg_roles="provider" ;;
        2)        reg_roles="consumer" ;;
        12|21)    reg_roles="provider,consumer" ;;
        ''|s|S)   reg_roles="" ;;
        *) log_warn "Unrecognised choice; skipping." ;;
    esac
    if [ -n "$reg_roles" ]; then
        local key; key="$(mint_key "$reg_roles")"
        cmd_register "$reg_roles" "$url" --authkey "$key" --yes
    else
        log_info "Skipped. Invite machines later with: connector invite"
    fi
}

cmd_link() {
    local host="" url="" port="" sshflag
    while [ $# -gt 0 ]; do
        case "$1" in
            --url)     url="$2"; shift 2 ;;
            -p|--port) port="$2"; shift 2 ;;
            -*) die "Unknown option: $1" ;;
            *) [ -z "$host" ] && host="$1" || die "Unexpected argument: $1"; shift ;;
        esac
    done
    [ -n "$host" ] && [ -n "$url" ] || die "Usage: connector link <user@host> --url https://vpn.example.com [-p port]"
    cnc_url_ok "$url" || die "Not a URL the CNC can be: $url"
    sshflag="$([ -n "$port" ] && echo "-p $port" || true)"
    log_info "Verifying CNC at $host..."
    # shellcheck disable=SC2086
    ssh -o ConnectTimeout=10 $sshflag "$host" 'test -f /etc/headscale/config.yaml' \
        || die "$host is not a configured CNC (no /etc/headscale/config.yaml)"
    save_cnc_link "$host" "$url" "$port"
    log_success "Linked to CNC $host. This machine is now a manager."
    echo "Try: connector list"
}

# Put this machine's connector on <target> as CONNECTOR_BIN, with the con
# link: copied into a directory of its own there (mktemp -d, the login user's
# alone), installed from it, and the directory removed in the same command
# whatever happened -- never a fixed name in /tmp, which anyone on that host
# could make first, or swap before root installs what it holds. stdin is
# closed unless sudo there may ask for a password. Returns 0/1.
# Args: target, sudo ("sudo " or ""), tty (1: sudo may prompt), [ssh port]
push_connector() {
    local target="$1" rsudo="$2" tty="$3" port="${4:-}" self dir cmd
    local -a ssh_o=(-o ConnectTimeout=10) scp_o=(-o ConnectTimeout=10)
    if [ -n "$port" ]; then ssh_o+=(-p "$port"); scp_o+=(-P "$port"); fi
    self="$(self_path)"
    dir="$(ssh "${ssh_o[@]}" "$target" 'mktemp -d /tmp/connector.XXXXXXXXXX' </dev/null 2>/dev/null | tr -d '\r')" || dir=""
    if ! [[ "$dir" =~ ^/tmp/connector\.[A-Za-z0-9]{10}$ ]]; then
        log_warn "   ${target} made no directory of its own to copy into (it said '${dir:0:40}')."
        return 1
    fi
    if ! scp -q "${scp_o[@]}" "$self" "$target:$dir/connector" </dev/null >/dev/null 2>&1; then
        ssh "${ssh_o[@]}" "$target" "rm -rf $dir" </dev/null >/dev/null 2>&1 || true
        log_warn "   copy to ${target} failed."
        return 1
    fi
    cmd="${rsudo}install -m 0755 $dir/connector ${CONNECTOR_BIN} && ${rsudo}ln -sf ${CONNECTOR_BIN} ${CON_BIN}; rc=\$?; rm -rf $dir; exit \$rc"
    if [ "$tty" = 1 ]; then
        ssh -t "${ssh_o[@]}" "$target" "$cmd"
    else
        ssh "${ssh_o[@]}" "$target" "$cmd" </dev/null
    fi
}

# Push this machine's connector to the linked CNC and install it. Returns 0/1.
cnc_update_push() {
    load_cnc_link
    local self sshflag rsudo="sudo " lsum rsum
    self="$(self_path)"
    sshflag="$([ -n "${CNC_PORT:-}" ] && echo "-p $CNC_PORT" || true)"
    [ "${CNC_USER:-}" = "root" ] && rsudo=""

    log_info "-> CNC ${CNC_SSH} (${CONNECTOR_BIN})"
    push_connector "$CNC_SSH" "$rsudo" 0 "${CNC_PORT:-}" || { log_warn "   install on CNC failed."; return 1; }

    lsum="$(file_sha256 "$self")"
    # shellcheck disable=SC2086
    rsum="$(ssh $sshflag "$CNC_SSH" "sha256sum ${CONNECTOR_BIN} 2>/dev/null || shasum -a 256 ${CONNECTOR_BIN} 2>/dev/null" | awk '{print $1}' | tr -d '\r')"
    if [ -n "$lsum" ] && [ "$lsum" = "$rsum" ]; then
        log_success "   updated + verified (sha256 ${lsum:0:12}...)"
    else
        log_warn "   installed, but checksum unverified (local=${lsum:-?} cnc=${rsum:-?})."
    fi
    # a daily backup that is scheduled there runs as this connector writes it
    ssh_cnc "${rsudo}${CONNECTOR_BIN} backup-schedule-local --refresh" </dev/null >/dev/null 2>&1 \
        || log_warn "   its daily backup's units are as they were: connector backup-schedule"
}

# Push this machine's connector to a provider node over Tailscale SSH. Returns 0/1.
provider_update_push() {
    local name="$1" user
    user="$(id -un)"
    log_info "-> provider ${name} (ssh ${user}@${name})"
    push_connector "${user}@${name}" "sudo " 1 \
        || { log_warn "   remote install failed (online + SSH-reachable? sudo rights?)."; return 1; }
    log_success "   updated."
}

# Push this machine's connector script to the linked CNC and install it there.
cmd_cnc_update() {
    is_manager || die "No CNC linked. Run this from a manager (set up via 'connector cnc-init' or 'connector link')."
    have ssh || die "ssh not found"; have scp || die "scp not found"
    cnc_update_push
}

# Print provider node names (TAB online-flag) from the CNC's headscale.
provider_nodes() {
    local json; json="$(hs nodes list -o json 2>/dev/null)" || return 1
    have jq || return 1
    printf '%s' "$json" | jq -r '.[]
        | select((.tags // []) | index("tag:provider"))
        | "\(.given_name)\t\(.online)"' 2>/dev/null
}

# Update connector everywhere: the CNC and (optionally) provider nodes.
cmd_propagate_update() {
    is_manager || die "Run from a manager (linked via 'connector cnc-init' or 'connector link')."
    have ssh || die "ssh not found"; have scp || die "scp not found"
    load_cnc_link

    local all=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--all) all=1 ;;
            -*)       die "Unknown propagate-update option: $1 (use -a/--all for all targets)" ;;
            *)        die "propagate-update takes no positional targets (use -a/--all, or choose interactively)" ;;
        esac
        shift
    done

    local -a names=() kinds=()
    names+=("$CNC_SSH"); kinds+=("cnc")
    local nm on
    while IFS="$(printf '\t')" read -r nm on; do
        [ -n "$nm" ] || continue
        names+=("$nm"); kinds+=("provider:$on")
    done < <(provider_nodes 2>/dev/null || true)

    echo "Update connector on which targets?"
    local i label
    for i in "${!names[@]}"; do
        case "${kinds[$i]}" in
            cnc)            label="CNC          (${names[$i]})" ;;
            provider:true)  label="provider     ${names[$i]} (online)" ;;
            provider:false) label="provider     ${names[$i]} (offline - may be unreachable)" ;;
            *)              label="${names[$i]}" ;;
        esac
        printf "  [%d] %s\n" "$((i+1))" "$label"
    done
    echo "  [a] all of the above"

    local opts="A"
    for i in "${!names[@]}"; do opts+="/$((i+1))"; done
    local sel="a"
    if [ "$all" != 1 ] && [ "${ASSUME_YES:-0}" != "1" ]; then
        read -r -p "Select [${opts}]: " sel </dev/tty || sel="a"
    fi

    local -a chosen=()
    if [ -z "$sel" ] || printf '%s' " $sel " | grep -qiE ' (a|all|0) '; then
        for i in "${!names[@]}"; do chosen+=("$i"); done
    else
        local tok
        for tok in $sel; do
            case "$tok" in
                ''|*[!0-9]*) continue ;;
                *) [ "$tok" -ge 1 ] && [ "$tok" -le "${#names[@]}" ] && chosen+=("$((tok-1))") ;;
            esac
        done
    fi
    [ "${#chosen[@]}" -gt 0 ] || die "Nothing selected."

    echo
    local idx ok=0 fail=0
    for idx in "${chosen[@]}"; do
        case "${kinds[$idx]}" in
            cnc)         cnc_update_push && ok=$((ok+1)) || fail=$((fail+1)) ;;
            provider:*)  provider_update_push "${names[$idx]}" && ok=$((ok+1)) || fail=$((fail+1)) ;;
        esac
    done
    echo
    if [ "$fail" -eq 0 ]; then log_success "propagate-update complete: ${ok} updated."
    else log_warn "propagate-update finished: ${ok} updated, ${fail} failed."; fi
}

# --- Invite ------------------------------------------------------------------
# A headscale user's numeric id (default: connector's own user), created when
# it is the operators' and does not exist yet. Args: [name]
hs_user_id() {
    local name="${1:-$HEADSCALE_USER}" out id
    out="$(hs users list --output json 2>/dev/null)" || return 1
    id="$(printf '%s' "$out" | user_id_in "$name")"
    if [ -z "$id" ] && [ "$name" = "$HEADSCALE_OPS_USER" ]; then
        hs users create "$name" >/dev/null 2>&1 || return 1
        out="$(hs users list --output json 2>/dev/null)" || return 1
        id="$(printf '%s' "$out" | user_id_in "$name")"
    fi
    printf '%s\n' "$id"
}

# The id of user <name> in headscale's `users list --output json` on stdin.
user_id_in() {
    if have jq; then
        jq -r --arg n "$1" 'first(.[] | select(.name==$n) | .id) // empty' 2>/dev/null
        return 0
    fi
    # Fallback for pretty-printed JSON: each user object lists "id" then "name".
    tr '\n\t' '  ' | sed 's/  */ /g' \
        | grep -o "\"id\": *[0-9]* *, *\"name\": *\"$1\"" \
        | sed -n 's/.*"id": *\([0-9]*\).*/\1/p' | head -n1
}

# Mint a single-use, short-expiry pre-auth key for a role spec; echo the key.
# headscale's --user takes a numeric user ID, so we always resolve it. An
# operator's machine (ops) is the ops user's and carries no tag.
mint_key() {
    local roles key_tags="" user="$HEADSCALE_USER" uid out key
    roles="$(parse_node_roles "$1")"
    [ -n "$roles" ] || die "No roles given for key (expected provider and/or consumer, or ops)."
    if [ "$roles" = ops ]; then user="$HEADSCALE_OPS_USER"; else key_tags="$(tags_for_roles "$roles")"; fi
    uid="$(hs_user_id "$user" 2>/dev/null || true)"
    [ -n "$uid" ] || die "Could not resolve headscale user '$user' on the CNC (is headscale running? try: connector status)"
    local -a create=(preauthkeys create --user "$uid" --expiration "$KEY_EXPIRY" --output json)
    [ -z "$key_tags" ] || create+=(--tags "$key_tags")
    out="$(hs "${create[@]}" 2>/dev/null)" || die "Failed to create pre-auth key on CNC"
    key="$(printf '%s' "$out" | json_str key)"
    [ -n "$key" ] || die "Could not parse pre-auth key from headscale output"
    printf '%s\n' "$key"
}

# --- Prod keys ---------------------------------------------------------------
# A prod machine (cnc, a node) joins the admin tailnet as tag:prod, and its
# key is minted here alone: single-use, tag:prod and nothing else, expiring
# within the hour, the operators' (tagOwners). It goes to stdout -- for a
# pipe into that machine's join, which reads it on stdin and never puts it on
# an argv -- or into a new 0600 file. invite and approve refuse prod.
cmd_prod_key() {
    local out="" expiry="$KEY_EXPIRY" uid json key
    while [ $# -gt 0 ]; do
        case "$1" in
            --out)        out="$2"; shift 2 ;;
            --expiration) expiry="$2"; shift 2 ;;
            --yes|-y)     ASSUME_YES=1; shift ;;
            *) die "Usage: connector prod-key [--out FILE] [--expiration 10m..1h] [--yes]" ;;
        esac
    done
    is_admin || die "Only a CNC or manager mints a prod key."
    [[ "$expiry" =~ ^([1-9]|[1-5][0-9])m$|^60m$|^1h$ ]] || die "A prod key lives an hour at most (--expiration 1m..60m or 1h), not '$expiry'."
    [ -z "$out" ] || [ ! -e "$out" ] || die "$out exists: a prod key goes into a new file only."
    confirm "Mint a single-use tag:prod key, expiring in ${expiry}?" || die "Declined."
    uid="$(hs_user_id "$HEADSCALE_OPS_USER" 2>/dev/null || true)"
    [ -n "$uid" ] || die "Could not resolve headscale user '$HEADSCALE_OPS_USER' on the CNC."
    json="$(hs preauthkeys create --user "$uid" --tags tag:prod --expiration "$expiry" --output json 2>/dev/null)" \
        || die "Failed to create the prod key on the CNC."
    key="$(printf '%s' "$json" | json_str key)"
    [ -n "$key" ] || die "Could not parse the prod key from headscale's output."
    if [ -n "$out" ]; then
        ( umask 077; set -o noclobber; printf '%s\n' "$key" >"$out" ) || die "Could not write $out."
        log_success "Wrote a single-use tag:prod key to $out (0600); it expires in ${expiry}." >&2
    else
        printf '%s\n' "$key"
    fi
}

cmd_invite() {
    is_admin || die "Only a CNC or manager can invite. Link one: connector link <host> --url ..."
    # Roles may be given comma- or space-separated, e.g. 'provider,consumer'.
    # Any non-role token is treated as the new machine's hostname.
    local types=() name="" want_manager=0 migrate=0 tok
    for tok in $(printf '%s ' "$@" | tr ',' ' '); do
        case "$tok" in
            --migrate) migrate=1 ;;
            provider) types+=("provider") ;;
            consumer) types+=("consumer") ;;
            both)     types+=("provider"); types+=("consumer") ;;
            ops)      types+=("ops") ;;
            manager|controller|commander) want_manager=1 ;;
            prod|tag:*|--tags*) die "A prod machine is not invited: its key comes from 'connector prod-key' alone." ;;
            *) name="$tok" ;;
        esac
    done

    if [ "${#types[@]}" -eq 0 ] && [ "$want_manager" -eq 0 ]; then
        echo "Invite as (comma-separated for multiple, e.g. provider,consumer):"
        echo "  [1] provider"
        echo "  [2] consumer"
        echo "  [3] manager (commands the CNC over SSH)"
        echo "  [4] ops (an operator's machine: reaches prod on ssh and https)"
        local sel n
        read -r -p 'Enter roles: ' sel || sel=""
        for n in $(printf '%s' "$sel" | tr ',' ' '); do
            case "$n" in
                1|provider) types+=("provider") ;;
                2|consumer) types+=("consumer") ;;
                3|manager|controller|commander) want_manager=1 ;;
                4|ops) types+=("ops") ;;
                *) log_warn "Ignoring invalid choice: $n" ;;
            esac
        done
    fi
    [ "${#types[@]}" -eq 0 ] && [ "$want_manager" -eq 0 ] && die "Nothing selected."

    if [ "$want_manager" -eq 1 ]; then
        invite_manager
    fi

    if [ "${#types[@]}" -gt 0 ]; then
        local roles url key hostarg=""
        roles="$(parse_node_roles "$(IFS=,; echo "${types[*]}")")"
        url="$(cnc_server_url)"; [ -n "$url" ] || url="<server-url>"
        key="$(mint_key "$roles")"
        [ -n "$name" ] && hostarg=" --hostname $name"
        echo
        if [ "$migrate" = 1 ]; then
            local fp oldarg=""
            fp="$(old_cnc_cert_pem | fp_of_pem)"
            [ -n "$fp" ] && oldarg=" --old-sha256 ${fp}"
            log_success "Single-use key to follow the CNC (roles: ${roles}, expires in ${KEY_EXPIRY})."
            echo "Run this on that machine:"
            echo
            echo "    connector migrate-cnc ${url} --authkey ${key}${oldarg}"
        else
            log_success "Single-use invite created (roles: ${roles}, expires in ${KEY_EXPIRY})."
            echo "Run this on the new machine:"
            echo
            echo "    connector register ${roles} ${url} --authkey ${key}${hostarg}"
        fi
        echo
    fi
}

# The self-signed certificate an older connector served the CNC's bare IP
# with, if the CNC still holds it (local, or over SSH): stdout, PEM.
old_cnc_cert_pem() {
    if is_cnc; then
        as_root cat "$HEADSCALE_CERT" 2>/dev/null || true
    elif is_manager; then
        load_cnc_link
        if [ "$CNC_USER" = "root" ]; then ssh_cnc cat "$HEADSCALE_CERT" 2>/dev/null || true
        else ssh_cnc sudo cat "$HEADSCALE_CERT" 2>/dev/null || true; fi
    fi
}

invite_manager() {
    is_admin || die "Only a CNC or manager can invite a manager."
    local url cnc_target pubkey
    url="$(cnc_server_url)"
    if is_manager; then load_cnc_link; cnc_target="$CNC_SSH"; else cnc_target="$(id -un)@$(node_name)"; fi

    echo
    echo "== Invite a manager =="
    echo "A manager commands the CNC over SSH, so its key must be authorized"
    echo "on the CNC admin account (${cnc_target})."
    echo "On the NEW manager, run 'connector manager-key' and paste its output here."
    echo
    read -r -p "Paste SSH public key: " pubkey || true
    [ -n "$pubkey" ] || die "No key provided."
    case "$pubkey" in
        ssh-*|ecdsa-*|sk-*) ;;
        *) die "That does not look like an SSH public key." ;;
    esac
    authorize_manager "$pubkey"
    log_success "Authorized the new manager's key on the CNC admin account."
    echo
    echo "Tell them to run:"
    echo "    connector link ${cnc_target} --url ${url}${CNC_PORT:+ -p $CNC_PORT}"
}

# Append a public key to the CNC admin account's authorized_keys.
authorize_manager() {
    local pubkey="$1"
    if is_cnc; then
        mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
        printf '%s\n' "$pubkey" >> "$HOME/.ssh/authorized_keys"
        chmod 600 "$HOME/.ssh/authorized_keys"
    else
        load_cnc_link
        printf '%s\n' "$pubkey" | ssh_cnc 'umask 077; mkdir -p "$HOME/.ssh"; cat >> "$HOME/.ssh/authorized_keys"'
    fi
}

cmd_manager_key() {
    local k key=""
    for k in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/id_rsa.pub"; do
        [ -f "$k" ] && { key="$k"; break; }
    done
    if [ -z "$key" ]; then
        log_info "No SSH key found; generating an ed25519 key..."
        ssh-keygen -t ed25519 -N "" -f "$HOME/.ssh/id_ed25519" -C "connector-manager@$(node_name)" >/dev/null
        key="$HOME/.ssh/id_ed25519.pub"
    fi
    echo "# Hand this public key to a CNC/manager running 'connector invite' -> manager:"
    cat "$key"
}

# --- Register (join the tailnet) --------------------------------------------
is_wsl()        { grep -qiE "(microsoft|wsl)" /proc/version 2>/dev/null || [ -n "${WSL_DISTRO_NAME:-}" ]; }
systemd_active() { [ -d /run/systemd/system ]; }

# A field of /etc/os-release, unquoted. Args: field
os_release_field() {
    awk -F= -v k="$1" '$1 == k { gsub(/^"|"$/, "", $2); print $2; exit }' "$OS_RELEASE" 2>/dev/null
}

# The apt distribution tailscale publishes for this machine, "<distro>
# <codename>": ubuntu, debian or raspbian, a derivative by the one it is
# like. Rc 1 when there is none.
ts_apt_dist() {
    local id like codename
    id="$(os_release_field ID)"; like=" $(os_release_field ID_LIKE) "
    case "$id" in
        ubuntu|debian|raspbian) codename="$(os_release_field VERSION_CODENAME)" ;;
        *)
            case "$like" in
                *" ubuntu "*) id=ubuntu; codename="$(os_release_field UBUNTU_CODENAME)" ;;
                *" debian "*) id=debian; codename="$(os_release_field VERSION_CODENAME)" ;;
                *) return 1 ;;
            esac
            ;;
    esac
    [[ "$codename" =~ ^[a-z0-9]+$ ]] || return 1
    printf '%s %s\n' "$id" "$codename"
}

# tailscale from its apt repository: the key fetched, checked to be the pinned
# one and no other before apt is told of it, and named alone by the source
# (signed-by) -- it vouches for that repository and nothing else.
install_tailscale_apt() {
    local dist codename key got arch
    read -r dist codename < <(ts_apt_dist) || true
    [ -n "${codename:-}" ] || die "No tailscale apt repository for this machine (${OS_RELEASE})."
    have gpg || pkg_install gnupg >/dev/null 2>&1 || die "gpg checks tailscale's key: install gnupg, then re-run register."
    key="$(mktemp)"
    curl -fsSL -o "$key" "https://pkgs.tailscale.com/stable/${dist}/${codename}.noarmor.gpg" \
        || { rm -f "$key"; die "Could not fetch tailscale's apt key."; }
    # every primary key the file holds: a second one would sign for the repository too
    got="$( { gpg --show-keys --with-colons "$key" 2>/dev/null || true; } | awk -F: '/^pub:/ { p = 1; next } p && /^fpr:/ { printf "%s%s", s, $10; s = " "; p = 0 }')"
    [ "$got" = "$TS_APT_KEY_FPR" ] || { rm -f "$key"; die "tailscale's apt key is ${got:-unreadable}, not the pinned ${TS_APT_KEY_FPR}; nothing installed."; }
    arch="$(dpkg --print-architecture)"
    if ! { as_root install -d -m 755 "${TS_APT_KEYRING%/*}" && as_root install -m 644 "$key" "$TS_APT_KEYRING"; }; then
        rm -f "$key"; die "Could not put tailscale's key in place."
    fi
    rm -f "$key"
    printf 'deb [arch=%s signed-by=%s] https://pkgs.tailscale.com/stable/%s %s main\n' "$arch" "$TS_APT_KEYRING" "$dist" "$codename" \
        | as_root tee "$TS_APT_LIST" >/dev/null
    as_root apt-get update -q >/dev/null || die "apt-get update failed with tailscale's repository."
    as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y tailscale
}

# tailscale on Linux: from its apt repository by its pinned key where apt is,
# else the distribution's own package -- never a script piped to a shell.
install_tailscale() {
    have tailscale && return 0
    log_info "Installing tailscale..."
    if have apt-get && ts_apt_dist >/dev/null; then
        install_tailscale_apt
    else
        case "$(pkg_mgr)" in
            # Arch mirrors keep only the newest build: -Sy refreshes the database first
            pacman)         as_root pacman -Sy --needed --noconfirm tailscale ;;
            apk|zypper|dnf) pkg_install tailscale ;;
            *) die "No tailscale package here: install it (https://tailscale.com/download), then re-run register." ;;
        esac
    fi
    have tailscale || die "tailscale installation failed; install it (https://tailscale.com/download), then re-run register."
}

install_tailscale_macos_app() {
    [ -x "$TS_MAC_APP_CLI" ] && return 0
    if have brew; then
        log_info "Installing the Tailscale GUI app (Homebrew cask)..."
        brew install --cask tailscale \
            || die "brew install --cask tailscale failed; install from https://tailscale.com/download/mac"
    else
        die "Install the Tailscale app from https://tailscale.com/download/mac (or install Homebrew), then re-run."
    fi
    open -a Tailscale 2>/dev/null || true
    log_warn "Launched Tailscale.app - if macOS prompts, allow its VPN/system extension, then re-run register."
}

install_tailscale_macos_oss() {
    have tailscale && return 0
    have brew || die "Homebrew is required for open-source tailscaled (https://brew.sh), or choose the app."
    log_info "Installing open-source tailscaled (Homebrew)..."
    brew install tailscale || die "brew install tailscale failed"
    log_info "Starting tailscaled as a service..."
    sudo brew services start tailscale >/dev/null 2>&1 || brew services start tailscale >/dev/null 2>&1 \
        || log_warn "Could not auto-start tailscaled; run: sudo brew services start tailscale"
}

# Choose (installing if needed) a macOS tailscale CLI. Prints the path on stdout;
# ALL prompts/messages go to stderr so the captured stdout is only the path.
# $2 (needs_ssh): 1 when the roles include provider. The sandboxed GUI app
# cannot host Tailscale SSH, so a provider must use open-source tailscaled.
macos_tailscale_cli() {
    local variant="$1" needs_ssh="${2:-0}" app="$TS_MAC_APP_CLI" oss have_app=0 have_oss=0 c p ans
    [ -x "$app" ] && have_app=1
    oss="$(command -v tailscale 2>/dev/null || true)"
    if [ -z "$oss" ]; then
        for p in /opt/homebrew/bin/tailscale /usr/local/bin/tailscale; do
            [ -x "$p" ] && { oss="$p"; break; }
        done
    fi
    [ -n "$oss" ] && have_oss=1
    case "$variant" in
        app) [ "$needs_ssh" = 1 ] && log_warn "The GUI app can't host Tailscale SSH; this Mac won't be a provider." >&2
             install_tailscale_macos_app >&2; printf '%s\n' "$app"; return 0 ;;
        oss) install_tailscale_macos_oss >&2; command -v tailscale; return 0 ;;
        "")  ;;
        *)   echo "Unknown --tailscale variant: $variant (use 'app' or 'oss')" >&2; return 1 ;;
    esac

    # A provider must host Tailscale SSH -> only open-source tailscaled works.
    if [ "$needs_ssh" = 1 ]; then
        if [ "$have_oss" = 1 ]; then
            log_info "Using open-source tailscaled (required to be a provider on macOS)." >&2
            printf '%s\n' "$oss"; return 0
        fi
        if [ "$have_app" = 1 ]; then
            log_warn "Only the Tailscale GUI app is installed; it CANNOT be a provider (no Tailscale SSH)." >&2
            read -r -p "Install open-source tailscaled so this Mac can be a provider? [Y/n]: " ans </dev/tty || ans=y
            case "${ans:-y}" in
                [nN]*) log_warn "Continuing with the GUI app: it joins the tailnet but is NOT a provider." >&2
                       printf '%s\n' "$app"; return 0 ;;
                *)     install_tailscale_macos_oss >&2; command -v tailscale; return 0 ;;
            esac
        fi
        { echo "Tailscale is not installed. A provider needs Tailscale SSH:"
          echo "  [1] GUI app                 - CANNOT be a provider (no Tailscale SSH)"
          echo "  [2] open-source tailscaled  - recommended (hosts SSH)"; } >&2
        read -r -p "Install [1/2] (default 2): " c </dev/tty || c=2
        case "${c:-2}" in
            1) install_tailscale_macos_app >&2; printf '%s\n' "$app" ;;
            *) install_tailscale_macos_oss >&2; command -v tailscale ;;
        esac
        return 0
    fi

    # Consumer (no SSH server needed): the GUI app is fine.
    if [ "$have_app" = 1 ] && [ "$have_oss" = 0 ]; then printf '%s\n' "$app"; return 0; fi
    if [ "$have_oss" = 1 ] && [ "$have_app" = 0 ]; then printf '%s\n' "$oss"; return 0; fi
    if [ "$have_app" = 1 ] && [ "$have_oss" = 1 ]; then
        { echo "Two Tailscale installs found:"
          echo "  [1] GUI app    ($app)"
          echo "  [2] tailscaled ($oss)"; } >&2
        read -r -p "Use which? [1/2]: " c </dev/tty || c=1
        case "$c" in 2) printf '%s\n' "$oss" ;; *) printf '%s\n' "$app" ;; esac
        return 0
    fi
    { echo "Tailscale is not installed. Install which variant?"
      echo "  [1] GUI app (Homebrew cask / tailscale.com download)"
      echo "  [2] open-source tailscaled (Homebrew, CLI only)"; } >&2
    read -r -p "Install [1/2]: " c </dev/tty || c=1
    case "$c" in
        2) install_tailscale_macos_oss >&2; command -v tailscale ;;
        *) install_tailscale_macos_app >&2; printf '%s\n' "$app" ;;
    esac
}

# `<cli...> <args...>`: tailscale up, the auth key (if any) read by tailscale
# from a 0600 file rather than from its argv, where any local user's ps would
# see it. The file goes when tailscale is done, or when connector is
# interrupted waiting for it. Args: key ('' for none), cli words..., --, args...
TS_KEY_FILE=""
ts_up() {
    local key="$1" rc=0
    local -a runner=()
    shift
    while [ "$1" != -- ]; do runner+=("$1"); shift; done
    shift
    if [ -n "$key" ]; then
        TS_KEY_FILE="$(umask 077; mktemp)" || return 1
        trap '[ -z "$TS_KEY_FILE" ] || rm -f "$TS_KEY_FILE"' EXIT
        printf '%s\n' "$key" >"$TS_KEY_FILE"
        set -- "$@" --auth-key "file:$TS_KEY_FILE"
    fi
    "${runner[@]}" "$@" || rc=$?
    if [ -n "$TS_KEY_FILE" ]; then rm -f "$TS_KEY_FILE"; TS_KEY_FILE=""; trap - EXIT; fi
    return "$rc"
}

# Print the post-join summary. register_summary <roles-csv> <cli> <hostname>
register_summary() {
    local roles="$1" cli="$2" hostname="$3" ts_ip ts_name
    ts_ip="$("$cli" ip -4 2>/dev/null | head -n1 || true)"
    ts_name="$("$cli" status --json 2>/dev/null | json_str DNSName)"; ts_name="${ts_name%.}"
    [ -n "$ts_name" ] || ts_name="$hostname"
    echo
    log_success "Connected as ${roles}."
    [ -n "$ts_ip" ] && echo "  Tailnet IP: $ts_ip"
    echo "  MagicDNS:   $ts_name"
    role_has "$roles" provider && echo "  Others reach you via:  ssh <user>@${ts_name}"
    role_has "$roles" consumer && echo "  Reach a provider via:  connector hop <provider-name>"
    role_has "$roles" consumer && echo "  Persistent tmux shell: connector hop -t <provider-name>"
}

register_macos() {
    local roles="$1" url="$2" key="$3" hostname="$4" variant="$5" reauth="${6:-0}" cli needs_ssh=0
    [ -n "$hostname" ] || hostname="$(node_name)"
    # Providers must host Tailscale SSH, which the sandboxed GUI app can't do;
    # let the CLI chooser steer to open-source tailscaled in that case.
    role_has "$roles" provider && needs_ssh=1
    cli="$(macos_tailscale_cli "$variant" "$needs_ssh")" || die "Could not determine a tailscale CLI."
    [ -n "$cli" ] || die "tailscale CLI not found after install."

    local tags ssh_flag=""
    tags="$(tags_for_roles "$roles")"
    role_has "$roles" provider && ssh_flag="--ssh"

    # GUI app talks to a per-user daemon (no sudo); oss tailscaled needs root.
    local -a runner_cmd
    if [ "$cli" = "$TS_MAC_APP_CLI" ]; then runner_cmd=("$cli"); else runner_cmd=(sudo "$cli"); fi

    # The sandboxed macOS GUI app cannot run the Tailscale SSH *server* ("does not
    # run in sandboxed Tailscale GUI builds"), which otherwise hard-fails 'up'.
    # Drop --ssh so registration succeeds; to host SSH as a provider on macOS, use
    # the open-source tailscaled instead (--tailscale oss).
    if [ -n "$ssh_flag" ] && [ "$cli" = "$TS_MAC_APP_CLI" ]; then
        log_warn "The Tailscale GUI app can't host Tailscale SSH (sandboxed build)."
        log_warn "Registering without --ssh: this Mac joins the tailnet but won't accept"
        log_warn "incoming 'connector hop'. To host SSH on macOS, re-run with --tailscale oss."
        ssh_flag=""
    fi

    log_info "Bringing up tailscale on macOS (roles: $roles, hostname: ${hostname:-auto})..."
    # --reset makes register declarative: apply exactly these flags and ignore
    # stale prefs from earlier attempts (tailscale otherwise refuses to change
    # settings without re-stating every non-default flag).
    # An auth key already carries its tags (forced tags). headscale rejects a
    # user-scoped key combined with --advertise-tags, so only advertise the tags
    # for interactive (keyless) registration where the admin owns them.
    local up_args=(up --reset --login-server "$url" --accept-dns=true)
    [ "$reauth" = 1 ] && up_args+=(--force-reauth)
    [ -n "$hostname" ] && up_args+=(--hostname "$hostname")
    [ -n "$ssh_flag" ] && up_args+=("$ssh_flag")
    [ -n "$key" ] || up_args+=(--advertise-tags="$tags")

    if ! ts_up "$key" "${runner_cmd[@]}" -- "${up_args[@]}"; then
        log_warn "tailscale up failed."
        log_warn "If a browser login URL appeared, finish there; or ask the admin to run 'connector approve'."
        log_warn "If using the GUI app, ensure it is running and its system extension is approved."
        die "tailscale up did not complete."
    fi
    mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$roles" > "$ROLE_FILE"
    install_self_local
    register_summary "$roles" "$cli" "$hostname"
}

# Consent-gated, idempotent WSL systemd enablement. Returns non-zero to abort.
ensure_wsl_systemd() {
    is_wsl || return 0
    systemd_active && return 0
    if grep -qs "systemd=true" /etc/wsl.conf 2>/dev/null; then
        log_warn "systemd is enabled in /etc/wsl.conf but not active yet."
        log_warn "Run 'wsl --shutdown' in Windows, reopen this distro, then re-run register."
        return 1
    fi
    log_warn "tailscale needs systemd, which is not enabled in this WSL distro."
    confirm "Enable systemd in /etc/wsl.conf now?" || { log_error "Cannot continue without systemd."; return 1; }
    as_root bash -c 'touch /etc/wsl.conf
if ! grep -q "^\[boot\]" /etc/wsl.conf; then
    printf "\n[boot]\nsystemd=true\n" >> /etc/wsl.conf
elif ! grep -q "systemd=true" /etc/wsl.conf; then
    sed -i "/^\[boot\]/a systemd=true" /etc/wsl.conf
fi'
    log_success "Enabled systemd in /etc/wsl.conf."
    log_warn "Now run 'wsl --shutdown' in Windows PowerShell, reopen this distro, then re-run your connector register command."
    return 1
}

maybe_fix_wsl_mtu() {
    is_wsl || return 0
    have ip || return 0
    local mtu
    mtu="$(ip link show tailscale0 2>/dev/null | sed -n 's/.* mtu \([0-9]\+\).*/\1/p' | head -n1)"
    if [ -n "$mtu" ] && [ "$mtu" -gt "$WSL_MTU" ]; then
        log_info "Pinning tailscale0 MTU to ${WSL_MTU} (WSL large-packet fix)..."
        as_root ip link set tailscale0 mtu "$WSL_MTU" 2>/dev/null || true
    fi
}

# Install the running connector to CONNECTOR_BIN and create the 'con' shortcut,
# so the node has 'connector'/'con' on PATH after joining. Never fatal.
install_self_local() {
    local self dir; self="$(self_path)"; dir="${CONNECTOR_BIN%/*}"
    [ -n "$self" ] && [ -f "$self" ] || return 0
    as_root mkdir -p "$dir" 2>/dev/null || true
    if [ "$self" != "$CONNECTOR_BIN" ]; then
        as_root install -m 0755 "$self" "$CONNECTOR_BIN" 2>/dev/null \
            || { log_warn "Could not install 'connector' to ${dir} (need sudo?); skipping."; return 0; }
    fi
    as_root ln -sf "$CONNECTOR_BIN" "$CON_BIN" 2>/dev/null || true
    log_success "Installed 'connector' + 'con' to ${dir}."
}

cmd_register() {
    local roles
    roles="$(parse_node_roles "${1:-}")"
    [ -n "$roles" ] || die "Usage: connector register <provider|consumer|provider,consumer|ops> <url> [--authkey KEY|-] [--hostname N] [--tailscale app|oss] [--yes]"
    shift || true
    local url="" key="" hostname="" ts_variant="" reauth=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --authkey)   key="$2"; shift 2 ;;
            --force-reauth) reauth=1; shift ;;
            --hostname)  hostname="$2"; shift 2 ;;
            --ca-sha256) die "--ca-sha256 is gone: the CNC is a DNS name with a public certificate, and connector installs no trust root. Ask your admin for a fresh invite." ;;
            --tailscale) ts_variant="$2"; shift 2 ;;
            --yes|-y)    ASSUME_YES=1; shift ;;
            -*) die "Unknown option: $1" ;;
            *) [ -z "$url" ] && url="$1" || die "Unexpected argument: $1"; shift ;;
        esac
    done
    [ -n "$url" ] || die "Usage: connector register <provider|consumer|provider,consumer|ops> <url> [--authkey KEY|-]"
    # `--authkey -`: the key on stdin, never on an argv
    if [ "$key" = "-" ]; then IFS= read -r key || true; [ -n "$key" ] || die "No key on stdin."; fi

    # On Linux, make sure the join flow's tools are present (prompt to install).
    [ "$(os_kind)" = "linux" ] && ensure_deps curl openssl

    # A DNS name with a public certificate: nothing to trust, and nothing installed.
    cnc_url_ok "$url" || die "Ask your admin for the CNC's https://<name> (a fresh invite)."

    if [ "$(os_kind)" = "macos" ]; then
        register_macos "$roles" "$url" "$key" "$hostname" "$ts_variant" "$reauth"
        return $?
    fi

    ensure_wsl_systemd || return 0
    install_tailscale
    [ -n "$hostname" ] || hostname="$(node_name)"

    local tags ssh_flag=""
    tags="$(tags_for_roles "$roles")"
    role_has "$roles" provider && ssh_flag="--ssh"

    log_info "Bringing up tailscale (roles: $roles, hostname: ${hostname:-auto})..."
    # --reset makes register declarative: apply exactly these flags and ignore
    # stale prefs from earlier attempts (tailscale otherwise refuses to change
    # settings without re-stating every non-default flag).
    # An auth key already carries its tags (forced tags). headscale rejects a
    # user-scoped key combined with --advertise-tags, so only advertise the tags
    # for interactive (keyless) registration where the admin owns them.
    local up_args=(--reset --login-server "$url" --accept-dns=true)
    [ "$reauth" = 1 ] && up_args+=(--force-reauth)
    [ -n "$hostname" ] && up_args+=(--hostname "$hostname")
    [ -n "$ssh_flag" ] && up_args+=("$ssh_flag")
    [ -n "$key" ] || up_args+=(--advertise-tags="$tags")

    if ! ts_up "$key" as_root tailscale up -- "${up_args[@]}"; then
        if [ -z "$key" ]; then
            log_warn "No --authkey supplied; tailscale printed a login URL above."
            log_warn "Ask the CNC admin to approve it:  connector approve"
        fi
        die "tailscale up did not complete."
    fi

    mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$roles" > "$ROLE_FILE"
    maybe_fix_wsl_mtu
    install_self_local
    register_summary "$roles" "tailscale" "$hostname"
}

# --- Migrate: a node follows the CNC to its new name ------------------------
# The CNC moved (an older connector's bare IP to a DNS name, or one name to
# another): this node joins it there with a fresh key, as the roles and name
# it had, and stops trusting the root an older connector installed for the
# old address -- that certificate, by its fingerprint, and nothing else.

# This node's tailscale prefs as JSON: what it is logged in to, and as what.
# Nothing when tailscale cannot say (its daemon down, say).
ts_prefs_json() {
    local variant="$1"
    if [ "$(os_kind)" = "macos" ] && { [ "$variant" = app ] || { [ -z "$variant" ] && [ -x "$TS_MAC_APP_CLI" ]; }; }; then
        "$TS_MAC_APP_CLI" debug prefs 2>/dev/null || true
    else
        as_root tailscale debug prefs 2>/dev/null || true
    fi
}

# A top-level JSON field of <json> (jq, else sed). Args: json, field
json_field() {
    if have jq; then printf '%s' "$1" | jq -r --arg f "$2" '.[$f] // empty' 2>/dev/null
    else printf '%s' "$1" | tr -d '\n' | json_str "$2"; fi
}

# The manager link, pointed at <url> (a URL load_cnc_link reads back); the ssh
# side of it is unchanged.
set_cnc_link_url() {
    local tmp
    link_value_ok CNC_URL "$1" || return 1
    tmp="$(mktemp "${CNC_LINK_FILE}.XXXXXX")" || return 1
    awk -v u="$1" '/^CNC_URL=/ { if (!done) print "CNC_URL=\"" u "\""; done = 1; next } { print } END { if (!done) print "CNC_URL=\"" u "\"" }' \
        "$CNC_LINK_FILE" >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$CNC_LINK_FILE" || { rm -f "$tmp"; return 1; }
}

cmd_migrate_cnc() {
    local url="" key="" old="" variant="" roles prefs current hostname kept=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --authkey)    key="$2"; shift 2 ;;
            --old-sha256) old="$(printf '%s' "$2" | tr 'A-F' 'a-f' | tr -d ': ')"; shift 2 ;;
            --tailscale)  variant="$2"; shift 2 ;;
            --yes|-y)     ASSUME_YES=1; shift ;;
            -*) die "Unknown option: $1" ;;
            *) if [ -z "$url" ]; then url="$1"; else die "Unexpected argument: $1"; fi; shift ;;
        esac
    done
    [ -n "$url" ] || die "Usage: connector migrate-cnc <https://new-name> --authkey KEY [--old-sha256 FP] [--tailscale app|oss] [--yes]"
    cnc_url_ok "$url" || die "Not a URL the CNC can be: $url"
    roles="$(node_role)"
    # a manager that is no node: its link follows, and nothing joins
    [ -n "$roles" ] || is_manager || die "This machine never registered with connector (no role); join it: connector register <roles> ${url} --authkey KEY"
    # The root to take away: the one this node recorded, and the one the admin names, agree.
    [ -s "$CNC_CA_FILE" ] && kept="$(fp_of_pem <"$CNC_CA_FILE")"
    if [ -n "$old" ] && [ -n "$kept" ] && [ "$old" != "$kept" ]; then
        die "The certificate this node trusted (${kept}) is not the one named (${old}); nothing changed."
    fi
    [ -n "$old" ] || old="$kept"

    if [ -z "$roles" ]; then
        log_info "Not a node here (no role): only the manager link follows."
    else
        prefs="$(ts_prefs_json "$variant")"
        current="$(json_field "$prefs" ControlURL)"
        hostname="$(json_field "$prefs" Hostname)"
        if [ "$current" = "$url" ]; then
            log_info "Already on ${url}; not re-joining."
        else
            [ -n "$key" ] || die "Re-joining at ${url} needs a fresh key: ask the admin for 'connector invite --migrate ${roles}'."
            log_info "Moving this node from ${current:-its old CNC} to ${url} (roles: ${roles})..."
            local -a args=("$roles" "$url" --authkey "$key" --force-reauth --yes)
            [ -n "$hostname" ] && args+=(--hostname "$hostname")
            [ -n "$variant" ] && args+=(--tailscale "$variant")
            cmd_register "${args[@]}"
        fi
    fi
    if [ -n "$old" ]; then
        untrust_cert_sha256 "$old" || die "The old CNC certificate is still trusted; see above."
        rm -f "$CNC_CA_FILE"
    else
        log_info "No old CNC certificate known here; nothing to stop trusting."
    fi
    if is_manager; then
        load_cnc_link
        if [ "$CNC_URL" != "$url" ]; then
            set_cnc_link_url "$url" || die "Could not point the manager link at ${url}."
            log_success "The manager link now names ${url}."
        fi
    fi
    log_success "Migrated to ${url}."
}

# --- Backup / restore --------------------------------------------------------
# The CNC's state -- headscale's database (a consistent copy), its noise and
# DERP keys, the Let's Encrypt cache, its config, policy and the site's rules
# -- as a tar encrypted with age to public keys alone (age1... or an SSH
# ed25519 key): the private half never needs to be on the CNC. A restore is
# decrypted where that private half is (the admin's machine) and streamed to
# the CNC over SSH.

# Is <r> a public key a backup may be encrypted to? One line: an age key (in
# bech32's alphabet), or an ssh-ed25519 key and a comment of no control
# character -- a newline would carry a second line along.
backup_recipient_ok() {
    [[ "$1" =~ ^age1[02-9ac-hj-np-z]{58}$ || "$1" =~ ^ssh-ed25519\ AAAA[A-Za-z0-9+/]+=*(\ [^[:cntrl:]]*)?$ ]]
}

# <word>s quoted for a remote shell, each after a space; nothing for none.
shell_words() {
    [ $# -eq 0 ] || printf ' %q' "$@"
}

# On the CNC, as root: the encrypted archive to stdout. Args: recipient...
# A subshell: the state it stages in the clear goes however it ends, and age
# has taken every recipient before any of that state is copied.
backup_stream_local() (
    local tmp="" r f
    trap '[ -z "$tmp" ] || rm -rf "$tmp"' EXIT
    require_root backup
    have age || pkg_install age >/dev/null 2>&1 || die "age encrypts the backup: apt-get install age"
    have sqlite3 || pkg_install sqlite3 >/dev/null 2>&1 || die "sqlite3 copies the database: apt-get install sqlite3"
    tmp="$(mktemp -d)"
    { if [ -s "$HEADSCALE_BACKUP_RECIPIENTS" ]; then grep -v '^[[:space:]]*#' "$HEADSCALE_BACKUP_RECIPIENTS" || true; fi
      for r in "$@"; do printf '%s\n' "$r"; done; } | awk 'NF' >"$tmp/recipients"
    [ -s "$tmp/recipients" ] || die "No recipient: pass --recipient <age1...|ssh-ed25519 ...> (a key whose private half is not on this machine), or list them in ${HEADSCALE_BACKUP_RECIPIENTS}."
    while IFS= read -r r; do
        backup_recipient_ok "$r" || die "Not a recipient: a backup is encrypted to age1... or ssh-ed25519 public keys alone"
    done <"$tmp/recipients"
    age -R "$tmp/recipients" </dev/null >/dev/null || die "age takes no such recipient (above); nothing was copied."
    mkdir -p "$tmp/state${HEADSCALE_LIB}" "$tmp/state/etc/headscale"
    [ -f "$HEADSCALE_LIB/db.sqlite" ] || die "No headscale database at $HEADSCALE_LIB/db.sqlite."
    sqlite3 "$HEADSCALE_LIB/db.sqlite" ".backup '$tmp/state${HEADSCALE_LIB}/db.sqlite'" || die "Could not copy the database."
    for f in noise_private.key derp_server_private.key cache certs; do
        [ ! -e "$HEADSCALE_LIB/$f" ] || cp -a "$HEADSCALE_LIB/$f" "$tmp/state${HEADSCALE_LIB}/" || die "Could not copy $HEADSCALE_LIB/$f."
    done
    for f in "$HEADSCALE_CONFIG" "$HEADSCALE_ACL" "$HEADSCALE_ACL_SITE" "$HEADSCALE_BACKUP_RECIPIENTS"; do
        [ ! -e "$f" ] || cp -a "$f" "$tmp/state/etc/headscale/" || die "Could not copy $f."
    done
    tar -C "$tmp/state" -cf - . | age -R "$tmp/recipients"
)

cmd_backup() {
    local out="" r sudo="sudo "
    local -a rcpts=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --out)       out="$2"; shift 2 ;;
            --recipient) rcpts+=("$2"); shift 2 ;;
            *) die "Usage: connector backup [--out FILE] [--recipient <age1...|ssh-ed25519 ...>]..." ;;
        esac
    done
    for r in "${rcpts[@]+"${rcpts[@]}"}"; do backup_recipient_ok "$r" || die "Not a recipient: a backup is encrypted to age1... or ssh-ed25519 public keys alone (nothing of it was sent)"; done
    [ -n "$out" ] || [ ! -t 1 ] || out="headscale-$(date -u +%Y%m%dT%H%M%SZ).tar.age"
    [ -z "$out" ] || [ ! -e "$out" ] || die "$out exists: a backup goes into a new file only."
    if is_cnc; then
        set -- backup_stream_local "${rcpts[@]+"${rcpts[@]}"}"
    elif is_manager; then
        load_cnc_link
        [ "$CNC_USER" != root ] || sudo=""
        set -- ssh_cnc "${sudo}${CONNECTOR_BIN} backup-stream$(shell_words "${rcpts[@]+"${rcpts[@]}"}")"
    else
        die "Only a CNC or manager takes a backup."
    fi
    if [ -z "$out" ]; then "$@"; return; fi
    ( umask 077; set -o noclobber; "$@" >"$out" ) || { rm -f "$out"; die "The backup failed; nothing kept."; }
    [ "$(head -c 21 "$out")" = "age-encryption.org/v1" ] || { rm -f "$out"; die "That is not an encrypted backup; nothing kept."; }
    log_success "Backup: $out ($(wc -c <"$out" | tr -d ' ') bytes, 0600), encrypted to its recipients alone."
}

# On the CNC, as root: a decrypted backup (a tar) on stdin put in place. The
# state before is kept aside, and put back when any step of putting the
# backup in place fails or headscale cannot run what came. A subshell: the
# backup it stages in the clear goes however it ends.
restore_stream_local() (
    local stage="" aside bad why="" managed
    trap '[ -z "$stage" ] || rm -rf "$stage"' EXIT
    require_root restore
    managed="${HEADSCALE_CONFIG##*/} ${HEADSCALE_ACL##*/} ${HEADSCALE_ACL_SITE##*/} ${HEADSCALE_BACKUP_RECIPIENTS##*/}"
    stage="$(mktemp -d)"
    cat >"$stage/backup.tar" || die "Could not read the backup; nothing changed."
    [ -s "$stage/backup.tar" ] || die "No backup came (could it be decrypted?); nothing changed."
    # what a backup holds and nothing else: files and directories under the
    # two places, no link of either kind, no .. -- each name whole (tar -t
    # prints one a line), each type from tar -tv
    { tar -tvf "$stage/backup.tar" >"$stage/types" && tar -tf "$stage/backup.tar" >"$stage/names"; } 2>/dev/null \
        || die "Not a backup tar can read; nothing changed."
    bad="$(awk '$1 !~ /^[-d]/ || / link to /' "$stage/types"
           awk '/(^|\/)\.\.(\/|$)/ { print; next }
                /^\.\/(var\/lib\/headscale|etc\/headscale)(\/|$)/ { next }
                $0 == "./" || $0 == "./var/" || $0 == "./var/lib/" || $0 == "./etc/" { next }
                { print }' "$stage/names")"
    [ -z "$bad" ] || die "Not a backup connector made; refused: $(printf '%s\n' "$bad" | awk 'NR == 1')"
    { mkdir "$stage/x" && tar -C "$stage/x" -xf "$stage/backup.tar"; } || die "Not a backup; nothing changed."
    [ -f "$stage/x${HEADSCALE_LIB}/db.sqlite" ] && [ -f "$stage/x$HEADSCALE_CONFIG" ] \
        || die "Not a headscale backup (no database, or no config); nothing changed."
    aside="${HEADSCALE_LIB}.before-restore-$(date -u +%Y%m%dT%H%M%SZ)"
    [ ! -e "$aside" ] || die "${aside} is there already; nothing changed."
    systemctl stop headscale 2>/dev/null || true
    if ! mv "$HEADSCALE_LIB" "$aside"; then
        systemctl start headscale 2>/dev/null || true
        die "Could not set the state aside; nothing changed."
    fi
    if ! restore_keep_etc "$aside" "$managed"; then
        rm -rf "${aside:?}/etc" && mv "$aside" "$HEADSCALE_LIB"
        systemctl start headscale 2>/dev/null || true
        die "Could not set the state aside; nothing changed."
    fi
    if ! restore_put "$stage/x" "$managed"; then why="it could not be put in place"
    elif ! headscale configtest >/dev/null 2>&1; then why="headscale cannot run it"
    fi
    if [ -n "$why" ]; then
        restore_undo "$aside" "$managed" \
            || die "Not restored (${why}), and the state before is still in ${aside}: put it back by hand (it, as ${HEADSCALE_LIB}; its etc/ files in /etc/headscale)."
        systemctl start headscale 2>/dev/null || true
        die "Not restored: ${why}; the state before is back in place."
    fi
    systemctl start headscale 2>/dev/null || true
    log_success "Restored. The state before is in ${aside}."
)

# restore_stream_local's steps, each rc 1 at the first thing that fails.
# The state now, set aside in <aside>: its /etc/headscale <files> in etc/.
restore_keep_etc() {
    local aside="$1" f
    mkdir -p "$aside/etc" || return 1
    for f in $2; do [ ! -e "/etc/headscale/$f" ] || cp -a "/etc/headscale/$f" "$aside/etc/" || return 1; done
}

# The backup extracted at <x> in place: /var/lib/headscale, and its
# /etc/headscale <files> (one the backup lacks is left out).
restore_put() {
    local x="$1" f
    { mkdir -p "$HEADSCALE_LIB" && cp -a "$x${HEADSCALE_LIB}/." "$HEADSCALE_LIB/"; } || return 1
    for f in $2; do
        rm -f "/etc/headscale/${f:?}" || return 1
        [ ! -e "$x/etc/headscale/$f" ] || cp -a "$x/etc/headscale/$f" /etc/headscale/ || return 1
    done
    ! id headscale >/dev/null 2>&1 || chown -R headscale:headscale "$HEADSCALE_LIB"
}

# The state set aside in <aside> back in place, its /etc/headscale <files> too.
restore_undo() {
    local aside="$1" f
    for f in $2; do
        rm -f "/etc/headscale/${f:?}"
        [ ! -e "$aside/etc/$f" ] || cp -a "$aside/etc/$f" /etc/headscale/
    done
    rm -rf "${aside:?}/etc" "${HEADSCALE_LIB:?}" && mv "$aside" "$HEADSCALE_LIB"
}

cmd_restore() {
    local file="" identity="" sudo="sudo "
    while [ $# -gt 0 ]; do
        case "$1" in
            --identity) identity="$2"; shift 2 ;;
            --yes|-y)   ASSUME_YES=1; shift ;;
            -*) die "Unknown option: $1" ;;
            *) if [ -z "$file" ]; then file="$1"; else die "Unexpected argument: $1"; fi; shift ;;
        esac
    done
    [ -f "$file" ] && [ -f "$identity" ] || die "Usage: connector restore <backup.tar.age> --identity <age or ssh private key file> [--yes]"
    have age || die "age decrypts the backup: install it here (brew install age / apt-get install age)."
    is_admin || die "Only a CNC or manager restores the CNC."
    # the whole file decrypts with this identity before any of it goes: age
    # stops at the first chunk that does not, and a tar cut there can still
    # read, short of what the backup held (the noise key, say)
    age -d -i "$identity" "$file" >/dev/null || die "${file} does not decrypt whole with ${identity} (above); nothing was sent."
    confirm "Replace the CNC's headscale state with ${file}'s? (the state now is kept aside)" || die "Declined."
    if is_cnc; then
        age -d -i "$identity" "$file" | restore_stream_local
    else
        load_cnc_link
        [ "$CNC_USER" != root ] || sudo=""
        age -d -i "$identity" "$file" | ssh_cnc "${sudo}${CONNECTOR_BIN} restore-stream"
    fi
}

# --- Scheduled backups -------------------------------------------------------
# The CNC backs itself up every day: the archive `backup` makes, encrypted to
# the public keys in /etc/headscale/backup.recipients, into a new 0600 file
# under /var/backups/headscale (0700), the newest <keep> kept -- a day whose
# backup failed deletes none. The private half is never on the CNC: a copy
# goes off it with scp, and `restore` takes it as it takes any backup.

# The service the daily timer starts. Args: keep
backup_service_unit() {
    cat <<EOF
# Written by connector backup-schedule: an edit here is replaced.
[Unit]
Description=connector: headscale's state, encrypted to its backup recipients
After=headscale.service

[Service]
Type=oneshot
UMask=0077
ExecStart=${CONNECTOR_BIN} backup-local --dir ${HEADSCALE_BACKUP_DIR} --keep $1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
EOF
}

backup_timer_unit() {
    cat <<'EOF'
# Written by connector backup-schedule: an edit here is replaced.
[Unit]
Description=connector: a daily encrypted backup of headscale's state

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
}

# Is <n> how many backups may stay?
backup_keep_ok() {
    [[ "$1" =~ ^[1-9][0-9]{0,3}$ ]]
}

# On the CNC, as root, from the timer: one backup into <dir>, and the newest
# <keep> kept, by the time in their names.
backup_local() {
    local dir="$HEADSCALE_BACKUP_DIR" keep="$HEADSCALE_BACKUP_KEEP" out f n=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --dir)  dir="$2"; shift 2 ;;
            --keep) keep="$2"; shift 2 ;;
            *) die "Usage: connector backup-local [--dir DIR] [--keep N]" ;;
        esac
    done
    require_root backup-local
    backup_keep_ok "$keep" || die "--keep is how many backups stay, 1 or more: not '$keep'"
    install -d -m 0700 "$dir" || die "Could not make $dir."
    out="$dir/headscale-$(date -u +%Y%m%dT%H%M%SZ).tar.age"
    [ ! -e "$out" ] || die "$out exists: a backup goes into a new file only."
    ( umask 077; set -o noclobber; backup_stream_local >"$out.part" ) || { rm -f "$out.part"; die "The backup failed; nothing kept."; }
    [ "$(head -c 21 "$out.part")" = "age-encryption.org/v1" ] || { rm -f "$out.part"; die "That is not an encrypted backup; nothing kept."; }
    mv -f "$out.part" "$out" || die "Could not keep $out."
    while IFS= read -r f; do
        n=$((n + 1))
        [ "$n" -le "$keep" ] || rm -f -- "$f"
    done < <(find "$dir" -maxdepth 1 -type f -name 'headscale-*.tar.age' | sort -r)
    log_success "Backup: $out ($(wc -c <"$out" | tr -d ' ') bytes, 0600)."
}

# On the CNC, as root: the daily backup, encrypted to <recipient>s (written
# to the recipients file) or, with none given, to those it lists; --off takes
# the timer away (the backups, and their recipients, stay); --refresh writes
# the units of a timer that is there as this connector does (cnc-init and
# cnc-update), and puts none in.
backup_schedule_local() {
    local keep="" off=0 refresh=0 r tmp unit n=0
    local -a rcpts=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --recipient) rcpts+=("$2"); shift 2 ;;
            --keep)      keep="$2"; shift 2 ;;
            --off)       off=1; shift ;;
            --refresh)   refresh=1; shift ;;
            *) die "Usage: connector backup-schedule [--recipient <age1...|ssh-ed25519 ...>]... [--keep N] | --off" ;;
        esac
    done
    require_root backup-schedule
    unit="$BACKUP_UNIT_DIR/connector-backup.service"
    if [ "$off" = 1 ]; then
        systemctl disable --now connector-backup.timer >/dev/null 2>&1 || true
        rm -f "$unit" "$BACKUP_UNIT_DIR/connector-backup.timer"
        systemctl daemon-reload >/dev/null 2>&1 || true
        log_success "No more daily backups; those in ${HEADSCALE_BACKUP_DIR} stay."
        return 0
    fi
    if [ "$refresh" = 1 ]; then
        [ -f "$unit" ] || return 0
        [ -n "$keep" ] || keep="$(sed -n 's/^ExecStart=.* --keep \([0-9]*\)$/\1/p' "$unit")"
    fi
    keep="${keep:-$HEADSCALE_BACKUP_KEEP}"
    backup_keep_ok "$keep" || die "--keep is how many backups stay, 1 or more: not '$keep'"
    for r in "${rcpts[@]+"${rcpts[@]}"}"; do backup_recipient_ok "$r" || die "Not a recipient: a backup is encrypted to age1... or ssh-ed25519 public keys alone"; done
    have age || pkg_install age >/dev/null 2>&1 || die "age encrypts the backups: apt-get install age"
    have sqlite3 || pkg_install sqlite3 >/dev/null 2>&1 || die "sqlite3 copies the database: apt-get install sqlite3"
    if [ "${#rcpts[@]}" -gt 0 ]; then
        tmp="$(mktemp)"
        { echo "# connector backup-schedule: the public keys a backup is encrypted to"; printf '%s\n' "${rcpts[@]}"; } >"$tmp"
        # age takes each, or none is written: a typo would fail every day's backup
        age -R "$tmp" </dev/null >/dev/null || { rm -f "$tmp"; die "age takes no such recipient (above); nothing changed."; }
        { mkdir -p "$(dirname "$HEADSCALE_BACKUP_RECIPIENTS")" && install -m 0644 "$tmp" "$HEADSCALE_BACKUP_RECIPIENTS"; } \
            || { rm -f "$tmp"; die "Could not write ${HEADSCALE_BACKUP_RECIPIENTS}."; }
        rm -f "$tmp"
    fi
    while IFS= read -r r; do
        backup_recipient_ok "$r" || die "${HEADSCALE_BACKUP_RECIPIENTS} holds a line that is no age1... or ssh-ed25519 public key"
        n=$((n + 1))
    done < <(grep -v '^[[:space:]]*#' "$HEADSCALE_BACKUP_RECIPIENTS" 2>/dev/null | awk 'NF')
    [ "$n" -gt 0 ] || die "No recipient: pass --recipient <age1...|ssh-ed25519 ...> (a key whose private half is not on this machine)."
    age -R "$HEADSCALE_BACKUP_RECIPIENTS" </dev/null >/dev/null \
        || die "age takes no such recipient in ${HEADSCALE_BACKUP_RECIPIENTS} (above); the daily backup is as it was."
    mkdir -p "$BACKUP_UNIT_DIR" || die "Could not make $BACKUP_UNIT_DIR."
    { backup_service_unit "$keep" >"$unit" && backup_timer_unit >"$BACKUP_UNIT_DIR/connector-backup.timer"; } \
        || die "Could not write the backup's units."
    { systemctl daemon-reload && systemctl enable --now connector-backup.timer >/dev/null 2>&1; } \
        || die "systemd did not take connector-backup.timer."
    log_success "A backup every day into ${HEADSCALE_BACKUP_DIR}, the newest ${keep} kept, encrypted to ${n} recipient(s)."
}

# Where the daily backup is put, or taken away: on the CNC itself, or from a
# manager over SSH.
cmd_backup_schedule() {
    local sudo="sudo " a prev=""
    # checked here first: a private key passed by mistake never leaves this machine
    for a in "$@"; do
        [ "$prev" != --recipient ] || backup_recipient_ok "$a" || die "Not a recipient: a backup is encrypted to age1... or ssh-ed25519 public keys alone (nothing of it was sent)"
        [ "$prev" != --keep ] || backup_keep_ok "$a" || die "--keep is how many backups stay, 1 or more: not '$a'"
        prev="$a"
    done
    if is_cnc; then
        backup_schedule_local "$@"
    elif is_manager; then
        load_cnc_link
        [ "$CNC_USER" != root ] || sudo=""
        ssh_cnc "${sudo}${CONNECTOR_BIN} backup-schedule-local$(shell_words "$@")"
    else
        die "Only a CNC or manager schedules the CNC's backups."
    fi
}

# --- Admin: list / approve / revoke -----------------------------------------
cmd_list() {
    is_admin || die "Only a CNC or manager can list nodes."
    local rows; rows="$(hs_nodes_tsv 2>/dev/null || true)"
    if [ -n "$rows" ]; then
        print_node_table "$rows"
    else
        hs nodes list   # fallback (no jq, or unexpected output)
    fi
}

approve_routes() {
    local id="$1"
    # Route-approval CLI differs across headscale versions; best-effort, never fatal.
    hs nodes approve-routes --identifier "$id" --routes "" >/dev/null 2>&1 \
        || hs routes enable --identifier "$id" >/dev/null 2>&1 \
        || true
}

cmd_approve() {
    is_admin || die "Only a CNC or manager can approve."
    local node="${1:-}" type="${2:-}"
    if [ -z "$node" ]; then
        echo "Nodes:"
        hs nodes list
        echo
        echo "Tag/approve a node that joined without a key:"
        echo "    connector approve <node-name|id> <provider|consumer|provider,consumer>"
        echo
        echo "(Simpler: 'connector invite' issues a single-use key so no approval step is needed.)"
        return 0
    fi
    # the roles first: one refused (prod, ops) touches nothing on the CNC
    local roles="" tags=""
    if [ -n "$type" ]; then
        roles="$(parse_node_roles "$type")"
        [ -n "$roles" ] || die "type must be provider, consumer, or provider,consumer"
        # approve tags; an operator's machine is untagged, and the ops user's from its key
        [ "$roles" != ops ] || die "An operator's machine is the ops user's, untagged: it joins with a key from 'connector invite ops', not by approve."
        tags="$(tags_for_roles "$roles")"
    fi
    local id; id="$(resolve_node_id "$node")" || die "Node not found: $node"
    approve_routes "$id"
    if [ -n "$tags" ]; then
        hs nodes tag --identifier "$id" --tags "$tags"
        log_success "Tagged node $node as $roles."
    fi
    log_success "Approved node $node (id $id)."
}

cmd_revoke() {
    is_admin || die "Only a CNC or manager can revoke nodes."
    local node="${1:-}"
    [ -n "$node" ] || die "Usage: connector revoke <node-name|node-id>"
    local id; id="$(resolve_node_id "$node")" || die "Node not found: $node"
    log_warn "Revoking node $node (id $id)..."
    hs nodes delete --identifier "$id" --force 2>/dev/null || hs nodes delete --identifier "$id"
    log_success "Revoked $node."
}

# --- Status / whoami ---------------------------------------------------------
cmd_status() {
    echo "Roles: $(current_roles)"
    if is_manager; then load_cnc_link; echo "Linked CNC: $CNC_SSH ($CNC_URL)"; fi
    echo
    if is_cnc; then
        if systemctl is-active --quiet headscale 2>/dev/null; then
            log_success "headscale service is running"
        else
            log_warn "headscale service is not running"
        fi
        echo
        as_root headscale nodes list 2>/dev/null || true
        return 0
    fi
    if have tailscale; then
        tailscale status || log_warn "tailscale not connected"
    else
        log_warn "tailscale is not installed on this machine."
    fi
}

cmd_whoami() {
    echo "Roles: $(current_roles)"
    if is_manager; then load_cnc_link; echo "Linked CNC: $CNC_SSH"; echo "Server URL: $CNC_URL"; fi
    if is_cnc; then echo "Server URL: $(cnc_server_url)"; fi
    if is_node; then
        local ip; ip="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
        [ -n "$ip" ] && echo "Tailnet IP: $ip"
    fi
}

# --- hop / alias -------------------------------------------------------------
# Run the tailscale CLI for this OS (prefer the macOS app's daemon).
ts_cli() {
    if [ "$(os_kind)" = "macos" ] && [ -x "$TS_MAC_APP_CLI" ]; then "$TS_MAC_APP_CLI" "$@"
    else tailscale "$@"; fi
}
have_ts() { { [ "$(os_kind)" = "macos" ] && [ -x "$TS_MAC_APP_CLI" ]; } || have tailscale; }

# jq snippet: derive a role label from a tags array bound as $t.
JQ_ROLE='(if ($t|index("tag:provider")) and ($t|index("tag:consumer")) then "provider,consumer"
          elif ($t|index("tag:provider")) then "provider"
          elif ($t|index("tag:consumer")) then "consumer" else "-" end)'

# This node's view of the tailnet (self + visible peers) as TSV:
#   id <TAB> name <TAB> role <TAB> ip <TAB> online(1/0)   (id is "-" here).
ts_nodes_tsv() {
    have jq || return 1
    ts_cli status --json 2>/dev/null | jq -r "
        ([.Self] + ((.Peer // {}) | to_entries | map(.value)))[]
        | (.Tags // []) as \$t
        | [ \"-\",
            ((.DNSName // (.HostName + \".\")) | sub(\"\\\\.\$\";\"\") | split(\".\")[0]),
            $JQ_ROLE,
            ((.TailscaleIPs // []) | map(select(test(\":\")|not)) | .[0] // \"-\"),
            (if .Online then \"1\" else \"0\" end) ] | @tsv" 2>/dev/null
}

# All tailnet nodes from headscale (admin only) as the same TSV shape.
hs_nodes_tsv() {
    have jq || return 1
    local json; json="$(hs nodes list -o json 2>/dev/null)" || return 1
    [ -n "$json" ] || return 1
    printf '%s' "$json" | jq -r "
        .[] | (.tags // []) as \$t
        | [ (.id|tostring), .given_name, $JQ_ROLE,
            ((.ip_addresses // []) | map(select(test(\":\")|not)) | .[0] // \"-\"),
            (if .online then \"1\" else \"0\" end) ] | @tsv" 2>/dev/null
}

# Render TSV node rows as a clean table, adding ONLINE + CONNECTABLE (relative to
# this machine) columns. A consumer can SSH to online providers; self is never
# connectable. Drops machine/node keys, duplicate name, and expiration.
print_node_table() {
    local rows="$1" self_ip="" me_consumer=0
    [ -n "$rows" ] || { echo "No nodes found."; return 0; }
    { is_consumer || is_ops; } && me_consumer=1
    have jq && self_ip="$(ts_cli status --json 2>/dev/null | jq -r '(.Self.TailscaleIPs // [])[0] // empty' 2>/dev/null || true)"
    {
        printf 'ID\tNAME\tROLE\tIP\tONLINE\tCONNECTABLE\n'
        local id name role ip online onl conn
        while IFS=$'\t' read -r id name role ip online; do
            [ -n "$name" ] || continue
            [ "$online" = "1" ] && onl="yes" || onl="no"
            if [ -n "$self_ip" ] && [ "$ip" = "$self_ip" ]; then
                conn="no (self)"
            elif [ "$me_consumer" = 1 ] && [ "$online" = "1" ] && role_has "$role" provider; then
                conn="yes"
            else
                conn="no"
            fi
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${id:--}" "$name" "$role" "${ip:--}" "$onl" "$conn"
        done <<EOF
$rows
EOF
    } | { if have column; then column -t -s "$(printf '\t')"; else cat; fi; }
}

# List ONLY the hosts this machine can connect to: the CNC (for a manager) and
# online providers a consumer may SSH to. Used by 'help' + arg-less 'hop'/'ssh'.
# Quiet (prints nothing) when there is nothing to connect to.
print_hosts() {
    local out="" n names
    if is_manager; then
        load_cnc_link
        if [ -n "${CNC_SSH:-}" ]; then
            local cnc_name="${CNC_SSH##*@}"   # bare host/alias, e.g. 'nyc'
            out+="  ${cnc_name}  (cnc)"$'\n'
        fi
    fi
    if have_ts && { is_consumer || is_ops; } && have jq; then
        names="$(ts_cli status --json 2>/dev/null | jq -r '
            (.Peer // {}) | to_entries[] | .value
            | select((.Tags // []) | index("tag:provider"))
            | select(.Online == true)
            | (.DNSName // (.HostName + ".")) | sub("\\.$";"") | split(".")[0]' 2>/dev/null || true)"
        while IFS= read -r n; do [ -n "$n" ] && out+="  $n"$'\n'; done <<EOF
$names
EOF
    fi
    [ -n "$out" ] || return 0
    echo "Hosts you can connect to:"
    printf '%s' "$out"
}

# True if $1 names the linked CNC: the literal 'cnc', the CNC's ssh remote
# (e.g. 'root@1.2.3.4'), or its bare host/alias (e.g. 'nyc').
is_cnc_target() {
    [ "$1" = "cnc" ] && return 0
    is_manager || return 1
    [ -f "$CNC_LINK_FILE" ] || return 1
    load_cnc_link
    [ -n "${CNC_SSH:-}" ] || return 1
    [ "$1" = "$CNC_SSH" ] && return 0
    [ "$1" = "${CNC_SSH##*@}" ] && return 0
    return 1
}

cmd_hop() {
    local tmux=0 tflag="" session=""
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -t|--tmux)    tmux=1 ;;
            -a|--attach)  tmux=1; tflag="-a" ;;
            -l|--list)    tmux=1; tflag="-l" ;;
            -k|--kill)    tmux=1; tflag="-k" ;;
            -s|--session) tmux=1; session="${2:-}"; shift ;;
            --)           shift; while [ $# -gt 0 ]; do pos+=("$1"); shift; done; break ;;
            -*)           die "Unknown hop option: $1" ;;
            *)            pos+=("$1") ;;
        esac
        shift
    done
    local target="${pos[0]:-}"
    [ "${#pos[@]}" -ge 2 ] && [ -z "$session" ] && session="${pos[1]}"

    if [ -z "$target" ]; then
        print_hosts
        return 0
    fi

    # Resolve a saved alias (name -> user@magicdns-name) on the target token, so
    # 'connector <alias>' and 'connector hop <alias>' behave identically.
    local _aline; _aline="$(alias_lookup "$target" || true)"
    [ -n "$_aline" ] && target="${_aline#*|}"

    # Resolve an ssh target (+ optional port) once, for both CNC and provider hops.
    # The CNC is not a tailnet node: a manager reaches it over its existing admin
    # SSH. Accept the literal 'cnc' or the CNC's ssh remote name (e.g. 'nyc'), so
    # you can use the same name you linked it with.
    local ssh_target="" port=""
    if is_cnc_target "$target"; then
        is_cnc && die "This machine is the CNC."
        is_manager || die "Only a manager can hop to the CNC (link one: connector link ...)."
        load_cnc_link
        [ -n "${CNC_SSH:-}" ] || die "No CNC link found."
        ssh_target="$CNC_SSH"; port="${CNC_PORT:-}"
    elif [[ "$target" == *"@"* ]]; then
        ssh_target="$target"
    else
        ssh_target="$(id -un)@${target}"
    fi

    if [ "$tmux" = 1 ]; then
        hop_tmux "$ssh_target" "$port" "$tflag" "$session"
        return $?
    fi

    local p=""; [ -n "$port" ] && p="-p $port"
    # shellcheck disable=SC2086
    ssh $p "$ssh_target"
}

# Local record of which tmux.user.conf sha we last pushed to each ssh target.
tmux_push_cache_get() {
    [ -f "$TMUX_PUSH_CACHE" ] || return 0
    awk -F '\t' -v t="$1" '$1==t {print $2; exit}' "$TMUX_PUSH_CACHE" 2>/dev/null
}
tmux_push_cache_set() {
    local target="$1" sha="$2" tmp
    mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR" 2>/dev/null || true
    tmp="$(mktemp)"
    [ -f "$TMUX_PUSH_CACHE" ] && awk -F '\t' -v t="$target" '$1!=t' "$TMUX_PUSH_CACHE" > "$tmp" 2>/dev/null
    printf '%s\t%s\n' "$target" "$sha" >> "$tmp"
    mv "$tmp" "$TMUX_PUSH_CACHE"; chmod 600 "$TMUX_PUSH_CACHE" 2>/dev/null || true
}

# SSH to a host and attach/manage a persistent tmux session there. The heavy
# lifting runs on the remote via its own 'connector tmux' worker (connector is
# already installed on every provider/CNC), so dependency install + persistence
# setup reuse that machine's helpers. tflag is '' | '-a' | '-l' | '-k'.
hop_tmux() {
    local ssh_target="$1" port="$2" tflag="$3" session="$4"
    have ssh || die "ssh not found"
    local p=""; [ -n "$port" ] && p="-p $port"

    # Push our local tmux config so it follows us, without clobbering the remote's
    # own config (the remote layers this copy in via 'tmux -f'). Support both the
    # classic ~/.tmux.conf and the XDG path (~/.config/tmux/tmux.conf). The write
    # path is expanded on the REMOTE (single-quoted) so it honours its $HOME/XDG.
    local lconf="" c
    for c in "$HOME/.tmux.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"; do
        [ -f "$c" ] && { lconf="$c"; break; }
    done
    if [ -n "$lconf" ]; then
        local lsum cached
        lsum="$(file_sha256 "$lconf")"
        cached="$(tmux_push_cache_get "$ssh_target")"
        # shellcheck disable=SC2086
        if [ -n "$lsum" ] && [ "$lsum" = "$cached" ] && [ "${CONNECTOR_TMUX_FORCE_PUSH:-0}" != "1" ]; then
            :   # remote already has this exact config (per local cache); skip the copy
        elif ssh $p "$ssh_target" \
                'd="${XDG_CONFIG_HOME:-$HOME/.config}/connector"; mkdir -p "$d" && cat > "$d/tmux.user.conf"' \
                < "$lconf" 2>/dev/null; then
            [ -n "$lsum" ] && tmux_push_cache_set "$ssh_target" "$lsum"
        else
            log_warn "Could not push ${lconf} to ${ssh_target} (continuing)."
        fi
    fi

    local rcmd="$CONNECTOR_BIN tmux"
    [ -n "$tflag" ] && rcmd="$rcmd $tflag"
    [ -n "$session" ] && rcmd="$rcmd $(printf '%q' "$session")"
    # Capability check is folded into this single SSH: the remote needs a
    # connector new enough to define cmd_tmux (older ones would mistake 'tmux'
    # for an implicit hop target and SSH onwards). 'grep && exec ... || exit 97'
    # keeps that guard without a separate round trip; exit 97 is reserved so it's
    # distinguishable from a connection failure (255) or normal tmux exit codes.
    local rc=0
    # shellcheck disable=SC2086
    ssh -t $p "$ssh_target" "grep -q '^cmd_tmux()' '$CONNECTOR_BIN' 2>/dev/null && exec $rcmd || exit 97" || rc=$?
    flush_notes   # surface any local push warnings now that tmux released the TTY
    if [ "$rc" = 97 ]; then
        log_error "'connector' on ${ssh_target} is missing the 'tmux' command (out of date)."
        die "Update it from a manager:  connector propagate-update"
    fi
    return $rc
}

# Clone a tmux plugin repo if absent (idempotent, shallow). Never fatal.
clone_tmux_plugin() {
    local url="$1" dir="$2"
    [ -d "$dir/.git" ] && return 0
    git clone --depth 1 "$url" "$dir" >/dev/null 2>&1 || log_warn "Could not clone ${url}."
}

# Install TPM + tmux-resurrect + tmux-continuum, write the connector-managed
# tmux config (layering your personal config), and wire reboot persistence.
# Idempotent: safe to run on every hop. Runs on the host owning the session.
setup_persistent_tmux() {
    local plugins="$HOME/.tmux/plugins" tpm
    tpm="$plugins/tpm"
    mkdir -p "$STATE_DIR" "$TMUX_RESURRECT_DIR" "$plugins"
    chmod 700 "$STATE_DIR" 2>/dev/null || true

    clone_tmux_plugin https://github.com/tmux-plugins/tpm "$tpm"
    clone_tmux_plugin https://github.com/tmux-plugins/tmux-resurrect "$plugins/tmux-resurrect"
    clone_tmux_plugin https://github.com/tmux-plugins/tmux-continuum "$plugins/tmux-continuum"

    # The host's own personal config (classic or XDG path), used only as a
    # fallback when the client didn't push one. We never modify it.
    local host_conf="" c
    for c in "$HOME/.tmux.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"; do
        [ -f "$c" ] && { host_conf="$c"; break; }
    done
    local personal_block
    personal_block="if-shell '[ -f \"$TMUX_USER_CONF\" ]' 'source-file \"$TMUX_USER_CONF\"'"
    if [ -n "$host_conf" ]; then
        personal_block="$personal_block
if-shell '[ ! -f \"$TMUX_USER_CONF\" ] && [ -f \"$host_conf\" ]' 'source-file \"$host_conf\"'"
    fi

    # Rewritten each run so config/path changes propagate. We never touch the
    # host's own config; we only source it as a fallback personal config.
    cat > "$TMUX_CONF" <<EOF
# Managed by connector - do not edit (your tmux edits belong in your own config).
# Layer a personal config: the pushed client copy if present, else this host's own.
$personal_block

# Persistence: tmux-resurrect + tmux-continuum (auto save/restore).
set -g @resurrect-dir '$TMUX_RESURRECT_DIR'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
set -g @continuum-boot 'off'
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
run '$tpm/tpm'
EOF
    chmod 600 "$TMUX_CONF" 2>/dev/null || true

    setup_tmux_boot
}

# Reboot persistence via a systemd --user service + linger. Best-effort: on
# non-systemd hosts we keep disconnect-persistence and warn.
setup_tmux_boot() {
    if ! have systemctl || [ ! -d /run/systemd/system ]; then
        log_warn "No systemd here: tmux sessions persist across disconnects but not reboots."
        return 0
    fi
    local tmux_bin unit_dir unit user uid
    tmux_bin="$(command -v tmux)"; user="$(id -un)"; uid="$(id -u)"
    unit_dir="$HOME/.config/systemd/user"; unit="$unit_dir/connector-tmux.service"
    mkdir -p "$unit_dir"
    cat > "$unit" <<EOF
[Unit]
Description=connector persistent tmux server
Documentation=man:tmux(1)
After=network-online.target

[Service]
Type=forking
ExecStart=${tmux_bin} -L ${TMUX_SOCKET} -f ${TMUX_CONF} new-session -d -s main
ExecStop=${tmux_bin} -L ${TMUX_SOCKET} kill-server
KillMode=control-group
Restart=on-failure

[Install]
WantedBy=default.target
EOF
    # Linger first: it starts (and keeps) this user's systemd instance even with
    # no active login, so boot-time restore works AND the user bus exists for the
    # 'systemctl --user' calls below.
    if ! loginctl show-user "$user" 2>/dev/null | grep -q '^Linger=yes'; then
        loginctl enable-linger "$user" >/dev/null 2>&1 \
            || as_root loginctl enable-linger "$user" >/dev/null 2>&1 \
            || log_warn "Could not enable linger; for reboot persistence run: sudo loginctl enable-linger $user"
    fi
    # 'systemctl --user' needs these to reach the user bus; over a non-interactive
    # SSH they're often unset even though linger keeps the user manager running.
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$uid}"
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    systemctl --user enable connector-tmux.service >/dev/null 2>&1 \
        || log_warn "Could not enable the systemd user service (sessions still survive disconnects)."
}

# Launch the connector tmux server in the foreground; when it hands the TTY back
# (detach/exit), replay any buffered warnings, then end. Use instead of a bare
# 'exec tmux' so setup notes aren't lost behind tmux's alternate screen.
tmux_exec() {
    local rc=0
    tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" "$@" || rc=$?
    flush_notes
    exit "$rc"
}

# Populate TMUX_SES_NAMES / TMUX_SES_LABELS with this host's connector sessions.
collect_tmux_sessions() {
    TMUX_SES_NAMES=(); TMUX_SES_LABELS=()
    local name wins att plural
    while IFS='|' read -r name wins att; do
        [ -n "$name" ] || continue
        plural="windows"; [ "$wins" = "1" ] && plural="window"
        TMUX_SES_NAMES+=("$name")
        TMUX_SES_LABELS+=("$name ($wins $plural${att:+, $att})")
    done < <(tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" ls \
        -F '#{session_name}|#{session_windows}|#{?session_attached,attached,}' 2>/dev/null)
}

# Interactive attach picker. Execs into the chosen/new session; returns (so the
# caller creates the default) when there are no sessions; exits 0 on cancel.
tmux_pick() {
    collect_tmux_sessions
    [ "${#TMUX_SES_NAMES[@]}" -gt 0 ] || return 0
    echo "Sessions on $(node_name):"
    local i
    for i in "${!TMUX_SES_NAMES[@]}"; do
        printf '  [%d] %s\n' "$((i+1))" "${TMUX_SES_LABELS[$i]}"
    done
    echo "  [n] new session"
    echo "  [q] cancel"
    local sel; read -r -p "Select: " sel </dev/tty || sel="q"
    case "$sel" in
        ''|q|Q) exit 0 ;;
        n|N)
            local name; read -r -p "New session name: " name </dev/tty || name=""
            [ -n "$name" ] || name="main"
            tmux_exec new-session -A -s "$name"
            ;;
        *[!0-9]*) die "Invalid selection." ;;
        *)
            { [ "$sel" -ge 1 ] && [ "$sel" -le "${#TMUX_SES_NAMES[@]}" ]; } || die "Invalid selection."
            tmux_exec attach -t "${TMUX_SES_NAMES[$((sel-1))]}"
            ;;
    esac
}

# Kill a session (named, or chosen from a picker) after confirmation.
tmux_kill() {
    local session="$1"
    if [ -z "$session" ]; then
        collect_tmux_sessions
        [ "${#TMUX_SES_NAMES[@]}" -gt 0 ] || { echo "No sessions to kill."; return 0; }
        echo "Sessions on $(node_name):"
        local i
        for i in "${!TMUX_SES_NAMES[@]}"; do
            printf '  [%d] %s\n' "$((i+1))" "${TMUX_SES_LABELS[$i]}"
        done
        echo "  [q] cancel"
        local sel; read -r -p "Kill which? " sel </dev/tty || sel="q"
        case "$sel" in
            ''|q|Q) return 0 ;;
            *[!0-9]*) die "Invalid selection." ;;
            *) { [ "$sel" -ge 1 ] && [ "$sel" -le "${#TMUX_SES_NAMES[@]}" ]; } || die "Invalid selection."
               session="${TMUX_SES_NAMES[$((sel-1))]}" ;;
        esac
    fi
    tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" has-session -t "$session" 2>/dev/null \
        || die "No tmux session '$session' on $(node_name)."
    confirm "Kill tmux session '$session'?" || { log_info "Cancelled."; return 0; }
    tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" kill-session -t "$session" \
        && log_success "Killed session '$session'."
}

# Worker that owns the session (runs on the remote via 'hop -t', or locally).
# Ensures tmux + persistence are set up, then attaches/creates/lists/kills.
cmd_tmux() {
    local mode="create" session=""
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--attach)  mode="attach" ;;
            -l|--list)    mode="list" ;;
            -k|--kill)    mode="kill" ;;
            -s|--session) session="${2:-}"; shift ;;
            -*) die "Unknown tmux option: $1" ;;
            *) pos+=("$1") ;;
        esac
        shift
    done
    [ "${#pos[@]}" -ge 1 ] && [ -z "$session" ] && session="${pos[0]}"

    # Don't nest tmux: if we're already inside a session on THIS machine,
    # attaching/creating would fail ("sessions should be nested with care").
    # When we're inside the connector server, switch within it; else just inform.
    # (list/kill are safe inside tmux, so they're allowed through.)
    if [ -n "${TMUX:-}" ] && [ "$mode" != "list" ] && [ "$mode" != "kill" ]; then
        local _sock="${TMUX%%,*}"           # current session's socket path
        if [ "${_sock##*/}" = "$TMUX_SOCKET" ] && { [ "$mode" != "attach" ] || [ -n "$session" ]; }; then
            local want="${session:-main}"
            if [ "$mode" = "attach" ] && ! tmux -L "$TMUX_SOCKET" has-session -t "$want" 2>/dev/null; then
                log_warn "No tmux session '$want' on $(node_name)."
                die "Create it by dropping -a, e.g.:  connector tmux $want"
            fi
            tmux -L "$TMUX_SOCKET" has-session -t "$want" 2>/dev/null \
                || tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" new-session -d -s "$want"
            log_info "Already in the connector tmux; switching to '$want'."
            exec tmux -L "$TMUX_SOCKET" switch-client -t "$want"
        fi
        log_warn "Already inside a tmux session on $(node_name); not nesting."
        log_info "Detach first (prefix + d), then re-run your connector tmux command."
        return 0
    fi

    ensure_deps tmux git
    setup_persistent_tmux

    case "$mode" in
        list)
            tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" ls 2>/dev/null || echo "No sessions."
            return 0
            ;;
        kill)
            tmux_kill "$session"
            return $?
            ;;
        attach)
            # Strict attach: never auto-create a named session.
            if [ -n "$session" ]; then
                if tmux -L "$TMUX_SOCKET" -f "$TMUX_CONF" has-session -t "$session" 2>/dev/null; then
                    tmux_exec attach -t "$session"
                fi
                log_warn "No tmux session '$session' on $(node_name)."
                die "Create it by dropping -a, e.g.:  connector hop -t <host> $session"
            fi
            tmux_pick   # execs on choice; returns here only when no sessions exist
            ;;
    esac

    # default / -s / picker-with-no-sessions: attach-or-create.
    tmux_exec new-session -A -s "${session:-main}"
}

is_reserved() { local n; for n in "${RESERVED_COMMANDS[@]}"; do [ "$1" = "$n" ] && return 0; done; return 1; }

ensure_aliases_file() {
    mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR" 2>/dev/null || true
    [ -f "$ALIASES_FILE" ] || {
        printf '# connector aliases\n# format: name|user@magicdns-name\n' > "$ALIASES_FILE"
        chmod 600 "$ALIASES_FILE"
    }
}
alias_lookup() { [ -f "$ALIASES_FILE" ] && grep -E "^$1\|" "$ALIASES_FILE" 2>/dev/null | head -n1; }

cmd_alias() {
    local sub="${1:-list}"
    case "$sub" in
        ""|list|ls)
            ensure_aliases_file
            printf "%-20s %s\n" "NAME" "TARGET"
            local n t c=0
            while IFS='|' read -r n t; do
                [ -z "$n" ] && continue
                [[ "$n" == \#* ]] && continue
                printf "%-20s %s\n" "$n" "$t"; c=$((c+1))
            done < "$ALIASES_FILE"
            [ "$c" -eq 0 ] && echo "(none) - add one: connector alias <name> <user@magicdns-name>"
            ;;
        rm|remove|delete)
            local name="${2:-}"; [ -n "$name" ] || die "Usage: connector alias rm <name>"
            ensure_aliases_file
            local tmp; tmp="$(mktemp)"
            grep -vE "^$name\|" "$ALIASES_FILE" > "$tmp" 2>/dev/null || true
            mv "$tmp" "$ALIASES_FILE"; chmod 600 "$ALIASES_FILE"
            ssh_config_remove_block "$name"
            log_success "Removed alias $name"
            ;;
        *)
            local name="$1" target="${2:-}"
            [ -n "$name" ] && [ -n "$target" ] || die "Usage: connector alias <name> <user@magicdns-name>"
            is_reserved "$name" && die "Alias '$name' conflicts with a built-in command."
            ensure_aliases_file
            local tmp; tmp="$(mktemp)"
            grep -vE "^$name\|" "$ALIASES_FILE" > "$tmp" 2>/dev/null || true
            mv "$tmp" "$ALIASES_FILE"
            printf '%s|%s\n' "$name" "$target" >> "$ALIASES_FILE"; chmod 600 "$ALIASES_FILE"
            log_success "Saved alias $name -> $target   (run: connector $name)"
            if confirm "Add a matching ~/.ssh/config Host entry so 'ssh $name' works?"; then
                ssh_config_add_block "$name" "$target"
            fi
            ;;
    esac
}

ssh_config_add_block() {
    local name="$1" target="$2" user host
    if [[ "$target" == *"@"* ]]; then user="${target%@*}"; host="${target##*@}"; else user="$(id -un)"; host="$target"; fi
    mkdir -p "$(dirname "$SSH_CONFIG_FILE")"; chmod 700 "$(dirname "$SSH_CONFIG_FILE")" 2>/dev/null || true
    touch "$SSH_CONFIG_FILE"; chmod 600 "$SSH_CONFIG_FILE"
    if grep -qF "# BEGIN connector alias $name" "$SSH_CONFIG_FILE" 2>/dev/null; then
        log_warn "$SSH_CONFIG_FILE already has '$name'"; return 0
    fi
    cat >> "$SSH_CONFIG_FILE" <<EOF

# BEGIN connector alias $name
Host $name
    HostName $host
    User $user
# END connector alias $name
EOF
    log_success "Added Host '$name' to $SSH_CONFIG_FILE"
}

ssh_config_remove_block() {
    local name="$1" tmp
    [ -f "$SSH_CONFIG_FILE" ] || return 0
    grep -qF "# BEGIN connector alias $name" "$SSH_CONFIG_FILE" 2>/dev/null || return 0
    tmp="$(mktemp)"
    awk -v m="connector alias $name" '
        $0 == "# BEGIN " m {s=1; next}
        s && $0 == "# END " m {s=0; next}
        !s {print}' "$SSH_CONFIG_FILE" > "$tmp"
    mv "$tmp" "$SSH_CONFIG_FILE"; chmod 600 "$SSH_CONFIG_FILE"
    log_success "Removed Host '$name' from $SSH_CONFIG_FILE"
}

# --- Cleanup -----------------------------------------------------------------
cmd_cleanup() {
    log_warn "This will disconnect this machine from the tailnet."
    confirm "Continue?" || { log_info "Cancelled."; exit 0; }
    local cli=""
    if have tailscale; then cli="tailscale"; elif [ -x "$TS_MAC_APP_CLI" ]; then cli="$TS_MAC_APP_CLI"; fi
    if [ -n "$cli" ]; then
        if [ "$cli" = "$TS_MAC_APP_CLI" ]; then
            "$cli" down 2>/dev/null || true; "$cli" logout 2>/dev/null || true
        else
            as_root "$cli" logout 2>/dev/null || true; as_root "$cli" down 2>/dev/null || true
        fi
    fi
    rm -f "$ROLE_FILE"
    # An older connector's trusted CNC certificate: that one, by its fingerprint.
    if [ -s "$CNC_CA_FILE" ]; then
        untrust_cert_sha256 "$(fp_of_pem <"$CNC_CA_FILE")" && rm -f "$CNC_CA_FILE"
    fi
    if is_manager && confirm "Also forget the linked CNC?"; then
        rm -f "$CNC_LINK_FILE"; log_success "Forgot CNC link."
    fi
    log_success "Cleanup complete."
}

cmd_cleanup_cnc() {
    is_admin || die "Only a CNC or manager can run cleanup-cnc."
    log_warn "This will delete ALL nodes and stop headscale on the CNC."
    confirm "Continue?" || { log_info "Cancelled."; exit 0; }
    local out ids id
    out="$(hs nodes list --output json 2>/dev/null)" || out=""
    if have jq; then
        ids="$(printf '%s' "$out" | jq -r '.[].id' 2>/dev/null)"
    else
        ids="$(printf '%s' "$out" | tr '\n\t' '  ' | grep -o '"id": *"\{0,1\}[0-9]*' \
             | sed -n 's/.*"id": *"\{0,1\}\([0-9]*\).*/\1/p' | sort -un)"
    fi
    for id in $ids; do
        hs nodes delete --identifier "$id" --force >/dev/null 2>&1 || true
    done
    if is_cnc; then
        as_root systemctl stop headscale 2>/dev/null || true
        as_root systemctl disable headscale 2>/dev/null || true
        as_root rm -rf "$HEADSCALE_CERT_DIR" 2>/dev/null || true
    else
        ssh_cnc "sudo systemctl stop headscale; sudo systemctl disable headscale; sudo rm -rf '$HEADSCALE_CERT_DIR'" 2>/dev/null || true
    fi
    log_success "CNC cleaned up (nodes deleted, headscale stopped)."
    echo
    echo "Migrating from the old WireGuard connector? Tear down leftover state if present:"
    echo "  sudo systemctl disable --now wg-quick@wg-connector"
    echo "  sudo rm -f /etc/wireguard/wg-connector.conf"
    echo "  sudo rm -rf /var/lib/wsl-registry; sudo userdel -r connector 2>/dev/null"
    echo "  and remove any 'Match User connector' blocks from /etc/ssh/sshd_config"
}

# --- Help --------------------------------------------------------------------
cmd_help() {
    cat <<EOF
connector v${VERSION} - headscale/tailscale mesh manager

This machine: $(current_roles)

SETUP
  cnc-init [user@host] --url https://NAME[:PORT] [--acme tls-alpn-01|http-01]
           [--base-domain D] [--reinit] [-p SSH_PORT]
                       Set up the CNC (headscale) on a DNS name: headscale gets
                       NAME's certificate from Let's Encrypt (tls-alpn-01 on
                       :443, the default; or http-01 on :80, for another port)
                       and renews it itself; nodes install no trust root. With
                       user@host it runs remotely over SSH and links this PC as
                       a manager; a CNC already set up keeps its URL unless
                       --url names another (then every node follows with
                       migrate-cnc), and --reinit re-applies this connector.
                       --base-domain is MagicDNS's suffix (connector.mesh); a
                       re-run keeps the CNC's unless it names another.
  link <user@host> --url https://HOST[:PORT] [-p SSH_PORT]
                       Attach to an existing CNC (become a manager).
  cnc-update           [manager] Push this machine's connector script to
                       the linked CNC and install it there.
  propagate-update [-a] [manager] Update connector on the CNC and provider
                       nodes; pick from a list, or pass -a/--all for all.

ONBOARD                [admin: run on the CNC or a linked manager]
  invite [--migrate] [roles] [name]
                       roles is comma-separated: provider, consumer, manager,
                       or ops alone (an operator's machine: untagged, it
                       reaches prod on ssh and https). No args -> menu.
                       Mints a single-use key and prints the register command;
                       with --migrate, the migrate-cnc command a node already
                       registered follows the CNC to its new name with. A prod
                       machine is never invited (see prod-key).
  prod-key [--out FILE] [--expiration 1m..60m|1h] [--yes]
                       Mint the key a prod machine (cnc, a node) joins with:
                       single-use, tag:prod and nothing else, expiring within
                       the hour. stdout carries the key alone -- pipe it into
                       that machine's join, which reads it on stdin -- or
                       --out writes a new 0600 file.
  manager-key          Print this machine's SSH public key (for a
                       'manager' invite).
  approve [node] [roles]
                       Tag/approve a node that joined without a key
                       (roles comma-separated, e.g. provider,consumer).

JOIN
  register <roles> <url> [--authkey KEY|-] [--hostname N] [--tailscale app|oss] [--yes]
                       roles is comma-separated: provider[,consumer], or ops.
                       Join the tailnet (just paste the command 'invite' prints;
                       '--authkey -' reads the key from stdin). The key reaches
                       tailscale in a 0600 file, never on its command line.
                       Auto-handles WSL systemd (asks first), and on macOS
                       auto-detects the GUI app or open-source tailscaled
                       (override: --tailscale).

  migrate-cnc <url> --authkey KEY [--old-sha256 FP] [--tailscale app|oss] [--yes]
                       Follow the CNC to its new name (what 'invite --migrate'
                       prints): re-join with a fresh key as the roles and name
                       this node had, stop trusting the root an older connector
                       installed for the old address (that certificate, by its
                       SHA-256), and point a manager's link at the new URL
                       (a manager that is no node needs no key: only its link
                       follows).

USE
  status               Roles + tailscale/headscale status.
  whoami               Detected role(s) + linked CNC.
  list | ls            [admin] List nodes (role, IP, online, connectable).
  revoke <node>        [admin] Remove a node.
  hop [user@name|name|cnc] [-t|--tmux] [-s name] [-a] [-l] [-k [name]]
                       SSH to a provider by MagicDNS name (no arg = list the
                       hosts you can connect to). Managers reach the control
                       server via 'cnc' or its ssh remote name (e.g. 'connector
                       nyc'). Aliases: 'connector ssh <name>'; any non-command
                       word is an implicit hop -> 'connector <name>'.
                       -t/--tmux opens a persistent tmux session (survives
                       disconnects, and reboots on systemd hosts; uses your
                       ~/.tmux.conf). Default session is 'main'; name it with a
                       second word or -s. -a picks an existing session (a name
                       attaches strictly), -l lists, -k [name] kills.
  alias <name> <user@name> | alias list | alias rm <name>
                       Save an SSH shortcut (optionally writes ~/.ssh/config).
  backup [--out FILE] [--recipient <age1...|ssh-ed25519 ...>]...
                       [admin] The CNC's state (headscale's database, keys,
                       certificate cache, config and policy), encrypted on the
                       CNC to public keys alone (and those listed in
                       /etc/headscale/backup.recipients), into a new 0600 file.
  restore <backup.tar.age> --identity <private key file> [--yes]
                       [admin] Decrypt here, where the private key is, and put
                       the state in place on the CNC: the state before is kept
                       aside, and back if headscale cannot run what came.
  backup-schedule [--recipient <age1...|ssh-ed25519 ...>]... [--keep N] | --off
                       [admin] The CNC backs itself up every day, as backup
                       does, encrypted to the recipients (written to
                       /etc/headscale/backup.recipients; none given: those it
                       lists) into /var/backups/headscale, the newest N (14)
                       kept. --off stops it; the backups stay.
  cleanup              Disconnect this machine from the tailnet.
  cleanup-cnc          [admin] Delete all nodes + stop headscale.
  help                 This help.

Examples
  connector cnc-init root@203.0.113.1 --url https://vpn.example.com   # its A record -> 203.0.113.1
  connector invite consumer
  connector register consumer https://vpn.example.com --authkey hskey-xxxx
  connector hop my-laptop
  connector hop -t my-laptop work                # persistent tmux session 'work'
EOF
    echo
    print_hosts
}

# Once per hour, warn a manager if the CNC's connector differs and offer to sync.
maybe_check_cnc_sync() {
    is_manager || return 0
    [ -t 0 ] || return 0                     # interactive sessions only
    local stamp="$STATE_DIR/.synccheck" now=0 last=0 self lsum rsum sshflag
    now="$(date +%s 2>/dev/null || echo 0)"
    [ -f "$stamp" ] && last="$(cat "$stamp" 2>/dev/null || echo 0)"
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ "$now" -gt 0 ] && [ "$((now - last))" -lt 3600 ] && return 0
    load_cnc_link
    self="$(self_path)"; lsum="$(file_sha256 "$self")"
    [ -n "$lsum" ] || return 0
    sshflag="$([ -n "${CNC_PORT:-}" ] && echo "-p $CNC_PORT" || true)"
    # shellcheck disable=SC2086
    rsum="$(ssh -o ConnectTimeout=5 -o BatchMode=yes $sshflag "$CNC_SSH" \
        "sha256sum ${CONNECTOR_BIN} 2>/dev/null || shasum -a 256 ${CONNECTOR_BIN} 2>/dev/null" 2>/dev/null \
        | awk '{print $1}' | tr -d '\r')"
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$now" > "$stamp" 2>/dev/null || true
    [ -n "$rsum" ] || return 0               # CNC unreachable -> skip quietly
    if [ "$lsum" != "$rsum" ]; then
        echo
        log_warn "The CNC's connector is out of sync with this machine."
        confirm "Run 'propagate-update' to sync the CNC (and providers)?" y && cmd_propagate_update
    fi
}

# --- Dispatcher --------------------------------------------------------------
main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        cnc-init)       cmd_cnc_init "$@" ;;
        cnc-update)     cmd_cnc_update "$@" ;;
        propagate-update) cmd_propagate_update "$@" ;;
        link)           cmd_link "$@" ;;
        invite)         cmd_invite "$@" ;;
        manager-key|commander-key)  cmd_manager_key "$@" ;;
        register)       cmd_register "$@" ;;
        migrate-cnc)    cmd_migrate_cnc "$@" ;;
        prod-key)       cmd_prod_key "$@" ;;
        backup)         cmd_backup "$@" ;;
        restore)        cmd_restore "$@" ;;
        backup-stream)  backup_stream_local "$@" ;;     # over SSH, from a manager's backup
        backup-schedule) cmd_backup_schedule "$@" ;;
        backup-schedule-local) backup_schedule_local "$@" ;;  # over SSH, from a manager's backup-schedule
        backup-local)   backup_local "$@" ;;            # the daily timer's
        restore-stream) restore_stream_local "$@" ;;    # over SSH, from a manager's restore
        approve)        cmd_approve "$@" ;;
        list|ls)        cmd_list "$@" ;;
        revoke)         cmd_revoke "$@" ;;
        status)         cmd_status "$@" ;;
        whoami)         cmd_whoami "$@" ;;
        hop|ssh)        cmd_hop "$@" ;;
        tmux)           cmd_tmux "$@" ;;
        alias)          cmd_alias "$@" ;;
        cleanup)        cmd_cleanup "$@" ;;
        cleanup-cnc)    cmd_cleanup_cnc "$@" ;;
        help|--help|-h) cmd_help ;;
        *)
            # Not a built-in: treat the whole line as an implicit hop, so
            # 'connector <name>' == 'connector hop <name>' and flags work in
            # any position (e.g. 'connector -t <name>' or 'connector <name> -t').
            # cmd_hop resolves saved aliases on the target token itself.
            cmd_hop "$cmd" "$@"
            exit $?
            ;;
    esac

    # Opportunistically (and throttled) nudge managers when the CNC drifts.
    case "$cmd" in
        invite|list|status|approve|revoke|whoami) maybe_check_cnc_sync || true ;;
    esac
}

# Sourced (the tests) rather than run: define everything, do nothing.
[ "${BASH_SOURCE[0]}" != "$0" ] || main "$@"
